#define HB_SIZE         ((int)_Size.x)
#define HB_KIND         ((int)_Layout.x)
#define HB_UNITS        ((int)_Layout.y)
#define HB_JITTER       _Layout.z
#define HB_PER_ROW      ((int)_Layout.w)
#define HB_GAP          _Joint.x
#define HB_ROUNDNESS    _Joint.y
#define HB_CHIPPING     _Joint.z
#define HB_ROW_OFFSET   _Joint.w
#define HB_RANDOM_SHIFT (_Pattern.x > 0.5)
#define HB_LENGTH       ((int)_Pattern.y)
#define HB_BEVEL        _Shape.x
#define HB_DOME         _Shape.y
#define HB_FACETS       _Shape.z
#define HB_RISE_SPREAD  _Shape.w
#define HB_TILT         _ShapeMore.x
#define HB_ROUGHNESS    _ShapeMore.y
#define HB_SEED         ((uint)_ShapeMore.z)
#define HB_DEPTH        _Surface.x
#define HB_SMOOTHNESS   _Surface.y
#define HB_GAP_SMOOTH   _Surface.z
#define HB_METALLIC     _Surface.w
#define HB_EDGE_LIGHT   _Light.x
#define HB_CAVITY_DARK  _Light.y
#define HB_AO_BAKE      _Light.z
#define HB_LIGHT_WIDTH  _Light.w
#define HB_ROUGH_SMOOTH 0.08
#define HB_DENSITY      _Scatter.x
#define HB_PEBBLE       _Scatter.y
#define HB_ELONGATION   _Scatter.z
#define HB_FINE_CRACKS  _Scatter.w
#define HB_ORGANIC      (_Pattern.w > 0.5)
#define HB_FILL         (HB_KIND == KIND_FILL)
struct HB_Piece
{
    float edge;
    float2 offset;
    uint2 key;
    float4 frame;
};

uint HB_Hash(uint2 cell, uint seed)
{
    uint value = cell.x * 73856093u ^ cell.y * 19349663u ^ seed * 83492791u;

    value ^= value >> 13;
    value *= 0x5bd1e995u;
    value ^= value >> 15;

    return value;
}

float HB_Random(uint2 cell, uint seed)
{
    return (HB_Hash(cell, seed) & 0xFFFFu) / 65535.0;
}

float2 HB_Random2(uint2 cell, uint seed)
{
    return float2(HB_Random(cell, seed), HB_Random(cell, seed + 7919u));
}

uint2 HB_WrapCell(int2 cell, int count)
{
    return (uint2)(cell + count * WRAP) % (uint)count;
}

int2 HB_Wrap(int2 texel)
{
    int size = HB_SIZE;

    return (int2)((uint2)(texel + size * 4) % (uint)size);
}

float HB_HeightAt(int2 texel)
{
    return _HeightIn[HB_Wrap(texel)];
}

float HB_GroundAt(int2 texel)
{
    int2 wrapped = HB_Wrap(texel);

    return _HeightIn[wrapped] - _LiftIn[wrapped];
}

float2 HB_Uv(uint2 id)
{
    return (id + 0.5) * _Size.y;
}

float HB_Noise(float2 p, int period, uint seed)
{
    float2 lattice = floor(p);
    float2 f = p - lattice;
    int2 c = (int2)lattice;

    f = f * f * (3.0 - 2.0 * f);

    float a = HB_Random(HB_WrapCell(c, period), seed);
    float b = HB_Random(HB_WrapCell(c + int2(1, 0), period), seed);
    float d = HB_Random(HB_WrapCell(c + int2(0, 1), period), seed);
    float e = HB_Random(HB_WrapCell(c + int2(1, 1), period), seed);

    return lerp(lerp(a, b, f.x), lerp(d, e, f.x), f.y);
}

float HB_Fbm(float2 uv, int period, uint seed)
{
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;

    period = max(period, 1);

    [unroll]
    for (int octave = 0; octave < 4; octave++)
    {
        sum += HB_Noise(uv * period, period, seed + (uint)octave * 101u) * amplitude;
        total += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return sum / total;
}

float2 HB_Gradient(int2 cell, int period, uint seed)
{
    float angle = HB_Random(HB_WrapCell(cell, period), seed) * TAU;

    return float2(cos(angle), sin(angle));
}

float HB_Perlin(float2 p, int period, uint seed)
{
    float2 lattice = floor(p);
    float2 f = p - lattice;
    int2 c = (int2)lattice;
    float2 w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float a = dot(HB_Gradient(c, period, seed), f);
    float b = dot(HB_Gradient(c + int2(1, 0), period, seed), f - float2(1.0, 0.0));
    float d = dot(HB_Gradient(c + int2(0, 1), period, seed), f - float2(0.0, 1.0));
    float e = dot(HB_Gradient(c + int2(1, 1), period, seed), f - 1.0);

    return lerp(lerp(a, b, w.x), lerp(d, e, w.x), w.y) * 0.7 + 0.5;
}

float HB_PerlinFbm(float2 uv, int period, uint seed)
{
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;

    period = max(period, 1);

    [unroll]
    for (int octave = 0; octave < 5; octave++)
    {
        sum += HB_Perlin(uv * period, period, seed + (uint)octave * 101u) * amplitude;
        total += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return sum / total;
}

float HB_Organic(float2 uv, int period, uint seed)
{
    float2 warp = float2(HB_PerlinFbm(uv, period, seed + 1u), HB_PerlinFbm(uv, period, seed + 2u)) - 0.5;

    return HB_PerlinFbm(uv + warp * 0.5 / max(period, 1), period, seed);
}

float HB_SoftMin(float a, float b, float k)
{
    float low = min(a, b);

    return low - k * log(exp((low - a) / k) + exp((low - b) / k));
}

float HB_BoxEdge(float2 local, float2 size, float soft)
{
    return HB_SoftMin(min(local.x, size.x - local.x), min(local.y, size.y - local.y), soft);
}

float2 HB_Point(int2 cell, int count, uint seed)
{
    return 0.5 + (HB_Random2(HB_WrapCell(cell, count), seed) - 0.5) * HB_JITTER;
}

HB_Piece HB_Voronoi(float2 p, int count, uint seed, float soft)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float best = 1e9;
    int2 bestCell = 0;
    float2 bestVector = 0.0;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            int2 cell = int2(x, y);
            float2 toward = cell + HB_Point(base + cell, count, seed) - f;
            float distance = dot(toward, toward);

            if (distance < best)
            {
                best = distance;
                bestCell = cell;
                bestVector = toward;
            }
        }
    }

    float hard = 1e9;
    float distances[25];

    [unroll]
    for (int j = 0; j < 25; j++)
    {
        int2 cell = bestCell + int2(j % 5 - 2, j / 5 - 2);
        float2 toward = cell + HB_Point(base + cell, count, seed) - f;
        float2 across = toward - bestVector;

        distances[j] = dot(across, across) > 1e-6
            ? dot(0.5 * (bestVector + toward), normalize(across))
            : 1e9;
        hard = min(hard, distances[j]);
    }

    float sum = 0.0;

    [unroll]
    for (int k = 0; k < 25; k++)
        sum += exp((hard - distances[k]) / soft);

    HB_Piece piece;
    piece.edge = hard - soft * log(sum);
    piece.offset = -bestVector;
    piece.key = HB_WrapCell(base + bestCell, count);
    piece.frame = float4(-bestVector.x + 0.5, -bestVector.y + 0.5, 0.0, 1.0);
    return piece;
}

float HB_Joint(int column, uint row, int perRow, float stretch, uint seed)
{
    uint wrapped = HB_WrapCell(int2(column, 0), perRow).x;

    return (column + (HB_Random(uint2(wrapped, row), seed + 97u) - 0.5) * HB_JITTER * 0.8) * stretch;
}

HB_Piece HB_Courses(float2 p, int rows, int perRow, float soft, uint seed)
{
    float stretch = rows / (float)perRow;
    int row = (int)floor(p.y);
    uint course = HB_WrapCell(int2(row, 0), rows).x;
    float shift = HB_RANDOM_SHIFT
        ? HB_Random(uint2(course, 91u), seed) * stretch
        : ((course & 1u) != 0u ? HB_ROW_OFFSET * stretch : 0.0);
    float along = p.x + shift;
    int first = (int)floor(along / stretch);
    int column = first;
    float start = first * stretch;
    float end = start + stretch;

    [unroll]
    for (int k = -1; k <= 1; k++)
    {
        float a = HB_Joint(first + k, course, perRow, stretch, seed);
        float b = HB_Joint(first + k + 1, course, perRow, stretch, seed);

        if (along >= a && along < b)
        {
            column = first + k;
            start = a;
            end = b;
        }
    }

    float2 size = float2(end - start, 1.0);
    float2 local = float2(along - start, p.y - row);

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = uint2(HB_WrapCell(int2(column, 0), perRow).x, course);
    piece.frame = float4(local.x, local.y, 0.0, size.x);
    return piece;
}

HB_Piece HB_Herringbone(float2 p, int length, int period, float soft)
{
    float2 guess = float2((p.x + p.y) * 0.5, (p.x - p.y) / (2.0 * length));
    int2 base = (int2)floor(guess);
    float2 local = 0.0;
    float2 size = float2(length, 1.0);
    float2 centre = 0.0;
    float upright = 0.0;

    [loop]
    for (int i = -3; i <= 3; i++)
    {
        [unroll]
        for (int j = -2; j <= 2; j++)
        {
            int2 lattice = base + int2(i, j);
            float2 origin = float2(lattice.x + length * lattice.y, lattice.x - length * lattice.y);
            float2 q = p - origin;

            if (q.x >= 0.0 && q.x < length && q.y >= 0.0 && q.y < 1.0)
            {
                local = q;
                size = float2(length, 1.0);
                centre = origin + size * 0.5;
                upright = 0.0;
            }
            else if (q.x >= 0.0 && q.x < 1.0 && q.y >= 1.0 && q.y < 1.0 + length)
            {
                local = q - float2(0.0, 1.0);
                size = float2(1.0, length);
                centre = origin + float2(0.5, 1.0 + length * 0.5);
                upright = 1.0;
            }
        }
    }

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = HB_WrapCell((int2)floor(centre * 2.0), period * 2) + uint2((uint)upright * 65536u, 0u);
    piece.frame = upright > 0.5
        ? float4(local.y, local.x, 1.0, size.y)
        : float4(local.x, local.y, 0.0, size.x);
    return piece;
}

HB_Piece HB_Basket(float2 p, int length, int squares, float soft)
{
    int2 square = (int2)floor(p / length);
    uint2 wrapped = HB_WrapCell(square, squares);
    float2 inside = p - square * length;
    bool lying = ((wrapped.x + wrapped.y) & 1u) == 0u;
    float brick = floor(lying ? inside.y : inside.x);
    float2 local = lying ? float2(inside.x, inside.y - brick) : float2(inside.x - brick, inside.y);
    float2 size = lying ? float2(length, 1.0) : float2(1.0, length);

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = uint2(wrapped.x * 16u + (uint)brick, wrapped.y);
    piece.frame = lying ? float4(local.x, local.y, 0.0, length) : float4(local.y, local.x, 1.0, length);
    return piece;
}

struct HB_Pebble
{
    bool on;
    uint2 wrapped;
    float2 centre;
    float2 turned;
    float distance;
    float radius;
    float power;
};

HB_Pebble HB_PebbleAt(int2 cell, int2 base, float2 f, int count, float size, uint seed, float pack)
{
    HB_Pebble pebble;
    uint2 wrapped = HB_WrapCell(cell, count);

    pebble.wrapped = wrapped;
    pebble.on = HB_Random(wrapped, seed + 5u) < HB_DENSITY;
    pebble.centre = cell - base + HB_Point(cell, count, seed);

    float turn = HB_Random(wrapped, seed + 6u) * TAU;
    float stretch = 1.0 + HB_Random(wrapped, seed + 8u) * HB_ELONGATION;
    float pick = HB_Random(wrapped, seed + 9u);
    float radius = size * (0.4 + 0.6 * pick * pick);
    float grown = radius + pack * 1.5;
    float2 toward = f - pebble.centre;

    pebble.turned = float2(dot(toward, float2(cos(turn), sin(turn))),
                           dot(toward, float2(-sin(turn), cos(turn))) * stretch);
    pebble.distance = length(pebble.turned);

    float angle = atan2(pebble.turned.y, pebble.turned.x);
    float lobes = sin(angle * 2.0 + HB_Random(wrapped, seed + 12u) * TAU) * 0.5 +
                  sin(angle * 3.0 + HB_Random(wrapped, seed + 13u) * TAU) * 0.3 +
                  sin(angle * 5.0 + HB_Random(wrapped, seed + 14u) * TAU) * 0.2;

    pebble.radius = radius * (1.0 + (0.15 + HB_CHIPPING * 0.3) * lobes) + pack * 1.5;
    pebble.power = dot(toward, toward) - grown * grown;
    return pebble;
}

float HB_RoundMin(float a, float b, float k)
{
    float h = max(k - abs(a - b), 0.0) / k;

    return min(a, b) - h * h * k * 0.25;
}

void HB_ScatterPass(float2 p, int count, float size, uint seed, float unit, uint tag, float pack,
                    inout float best, inout float nearest, inout HB_Piece piece)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;
    int reach = pack > 0.0 ? 2 : 1;
    uint side = (uint)(reach * 2 + 1);
    float winnerScore = -1e9;
    HB_Pebble winner = (HB_Pebble)0;
    uint winnerIndex = 0u;

    [loop]
    for (uint j = 0u; j < side * side; j++)
    {
        int2 cell = base + int2((int)(j % side) - reach, (int)(j / side) - reach);
        HB_Pebble pebble = HB_PebbleAt(cell, base, f, count, size, seed, pack);

        if (!pebble.on)
            continue;

        float disc = pebble.radius - pebble.distance;

        nearest = max(nearest, disc * unit);

        float score = -pebble.power;

        if (pack <= 0.0)
        {
            if (disc <= 0.0)
                continue;

            uint stone = HB_Hash(pebble.wrapped + uint2(0u, tag), HB_SEED + 3u) & 0xFFFFFFu;
            float rise = 1.0 - HB_RISE_SPREAD * HB_Random(uint2(stone, 2u), HB_SEED);

            score = rise * (1.0 - pebble.distance * pebble.distance / (pebble.radius * pebble.radius));
        }

        if (score > winnerScore)
        {
            winnerScore = score;
            winner = pebble;
            winnerIndex = j;
        }
    }

    if (winnerScore <= -1e8)
        return;

    float edge = winner.radius - winner.distance;

    if (edge <= 0.0)
        return;

    if (pack > 0.0)
    {
        float round = 0.3 * size;

        [loop]
        for (uint k = 0u; k < side * side; k++)
        {
            if (k == winnerIndex)
                continue;

            int2 cell = base + int2((int)(k % side) - reach, (int)(k / side) - reach);
            HB_Pebble other = HB_PebbleAt(cell, base, f, count, size, seed, pack);

            if (!other.on)
                continue;

            float apart = max(length(other.centre - winner.centre), 1e-4);

            edge = HB_RoundMin(edge, (other.power - winner.power) / (2.0 * apart), round);
        }

        if (edge <= 0.0)
            return;
    }

    best = 0.0;
    piece.edge = edge * unit;
    piece.offset = winner.turned * unit;
    piece.key = winner.wrapped + uint2(0u, tag);
    piece.frame = float4((winner.turned + winner.radius) * unit, 0.0, winner.radius * 2.0 * unit);
}
HB_Piece HB_Scatter(float2 p, int count, uint seed)
{
    float best = -1.0;
    float nearest = -1e9;
    float pack = smoothstep(0.6, 1.0, HB_DENSITY);

    HB_Piece piece;
    piece.edge = -1.0;
    piece.offset = 0.0;
    piece.key = 0u;
    piece.frame = float4(0.0, 0.0, 0.0, 1.0);

    HB_ScatterPass(p, count, HB_PEBBLE, seed, 1.0, 0u, pack, best, nearest, piece);

    if (best < 0.0)
        HB_ScatterPass(p * 3.0, count * 3, HB_PEBBLE * 0.45, seed + 200u, 1.0 / 3.0, 0x10000u, 0.0, best,
                       nearest, piece);

    if (best < 0.0)
        piece.edge = nearest;

    return piece;
}

[numthreads(8, 8, 1)]
void Cells(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    int units = HB_UNITS;
    uint seed = HB_SEED;
    float soft = max(HB_ROUNDNESS * 0.15, 0.002);

    float2 warp = float2(HB_Fbm(uv, units * 2, seed + 11u), HB_Fbm(uv, units * 2, seed + 23u)) - 0.5;
    float2 p = uv * units + warp * HB_CHIPPING * 0.6;

    HB_Piece piece;

    if (HB_KIND == KIND_COURSES)
        piece = HB_Courses(p, units, HB_PER_ROW, soft, seed);
    else if (HB_KIND == KIND_HERRINGBONE)
        piece = HB_Herringbone(p, HB_LENGTH, units, soft);
    else if (HB_KIND == KIND_SCATTER)
        piece = HB_Scatter(p, units, seed);
    else if (HB_KIND == KIND_BASKET)
        piece = HB_Basket(p, HB_LENGTH, (int)((uint)units / (uint)max(HB_LENGTH, 1)), soft);
    else if (HB_KIND == KIND_FILL)
    {
        piece.edge = 4.0;
        piece.offset = 0.0;
        piece.key = 0u;

        float span = max((int)((uint)units / 2u), 1);

        piece.frame = float4(uv.x * 20.0 * span, uv.y * span, 2.0, 20.0 * span);
    }
    else
    {
        piece = HB_Voronoi(p, units, seed, soft);

        if (HB_FINE_CRACKS > 0.0)
        {
            int finePeriod = units * 8;
            float2 jag = float2(HB_PerlinFbm(uv, finePeriod, seed + 501u), HB_PerlinFbm(uv, finePeriod, seed + 502u));
            HB_Piece fine = HB_Voronoi(p * 2.0 + (jag - 0.5) * 0.5, units * 2, seed + 500u, 0.002);
            float reach = HB_PerlinFbm(uv, units * 3, seed + 503u);
            float start = lerp(0.72, 0.3, HB_FINE_CRACKS);
            float open = smoothstep(start, start + 0.12, reach);
            float fade = (1.0 - open) * (HB_BEVEL + 0.02) * 2.0;

            piece.edge = min(piece.edge, fine.edge * 0.5 + HB_GAP * 0.5 - HB_GAP * 0.3 * open + fade);
        }
    }

    float edge = piece.edge + (HB_Fbm(uv, units * 8, seed + 31u) - 0.5) * HB_CHIPPING * 0.08;
    float2 shape = piece.offset / (length(piece.offset) + max(edge, 1e-4));
    float stone = (HB_Hash(piece.key, seed + 3u) & 0xFFFFFFu) / 16777215.0;

    _Cells[id.xy] = float4(edge - HB_GAP * 0.5, stone, shape);
    _Frame[id.xy] = piece.frame;
}

uint HB_StoneKey(float stone)
{
    return (uint)(stone * 16777215.0 + 0.5);
}

float HB_StoneRandom(uint key, uint salt)
{
    return HB_Random(uint2(key, salt), HB_SEED);
}

void HB_WoodGrain(float4 frame, uint key, float ringDensity, float knots, uint seed, out float rings,
                  out float fibres, out float knot)
{
    float along = frame.x;
    float across = frame.y;
    float span = frame.z > 1.5 ? frame.w / 20.0 : 0.0;
    int bendPeriod = span > 0.0 ? (int)round(span * 7.0) : WIDE;
    int wobblePeriod = span > 0.0 ? (int)round(span * 3.0) : WIDE;
    int fibrePeriod = span > 0.0 ? (int)round(span * 40.0) : WIDE;
    float density = span > 0.0 ? max(round(ringDensity * span), 1.0) / span : ringDensity;
    float rows = span > 0.0 ? span : 1.0;
    float phase = HB_StoneRandom(key, 30u) * 300.0;

    float bend = (HB_Noise(float2(along * 0.35 + phase, 0.5), bendPeriod, seed) - 0.5) * 0.8;
    float wobble = (HB_Noise(float2(along * 1.5 + phase, across * 3.0), wobblePeriod, seed + 1u) - 0.5) * 0.15;
    float wave = across + bend + wobble;

    knot = 0.0;

    [unroll]
    for (int k = 0; k < KNOTS; k++)
    {
        uint salt = 32u + (uint)k * 5u;
        float chance = knots * (k == 0 ? 1.0 : 0.4);

        if (HB_StoneRandom(key, salt) >= chance)
            continue;

        float2 centre = float2(HB_StoneRandom(key, salt + 1u) * frame.w,
                               (0.2 + 0.6 * HB_StoneRandom(key, salt + 2u)) * rows);
        float radius = 0.06 + 0.08 * HB_StoneRandom(key, salt + 3u);
        float2 reach = float2((along - centre.x) / (radius * 3.0), (across - centre.y) / (radius * 1.6));

        wave += (across - centre.y) * exp(-dot(reach, reach)) * 1.5;
        knot = max(knot, saturate(1.0 - length(float2(along - centre.x, across - centre.y)) / radius));
    }

    float ring = frac(wave * density);

    rings = smoothstep(0.6, 1.0, 1.0 - abs(ring * 2.0 - 1.0));
    fibres = HB_Noise(float2(along * 2.0 + phase, across * 40.0), fibrePeriod, seed + 2u);
}

float HB_Ground(float2 uv)
{
    int period = (int)_Ground.y;
    float lumps = HB_Fbm(uv, period, HB_SEED + 41u);

    if (HB_ORGANIC)
    {
        float grit = HB_PerlinFbm(uv, period * 8, HB_SEED + 47u) - 0.5;

        lumps = saturate(HB_Organic(uv, period, HB_SEED + 41u) + grit * 0.12);
    }

    if (_Ground.z <= 0.0)
        return _Ground.x * lumps;

    int count = max((int)_Ground.w, 1);
    float bend = (HB_PerlinFbm(uv, 2, HB_SEED + 43u) - 0.5) * 3.0 + (HB_PerlinFbm(uv, 5, HB_SEED + 44u) - 0.5) +
                 (lumps - 0.5) * 0.5;
    float wave = frac(uv.x * count + bend * _GroundMore.x * 2.0);
    float ripple = smoothstep(0.0, 1.0, wave < 0.75 ? wave / 0.75 : (1.0 - wave) / 0.25);
    float strength = smoothstep(0.25, 0.75, HB_PerlinFbm(uv, 3, HB_SEED + 45u)) * 0.7 + 0.3;
    float fineBend = (HB_PerlinFbm(uv, 4, HB_SEED + 46u) - 0.5) * 2.0 + bend * 0.5;
    float fine = frac((uv.x * 3.0 + uv.y) * count + fineBend * _GroundMore.x * 2.0);
    float shaped = ripple * strength * 0.75 + (1.0 - abs(fine * 2.0 - 1.0)) * 0.1 + lumps * 0.25;

    return _Ground.x * lerp(lumps, shaped, saturate(_Ground.z));
}

float HB_CellEdge(float2 p, int count, uint seed)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float best = 1e9;
    float2 closest = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        float2 toward = cell - base + HB_Random2(HB_WrapCell(cell, count), seed) - f;
        float distance = dot(toward, toward);

        if (distance < best)
        {
            best = distance;
            closest = toward;
        }
    }

    float edge = 1e9;

    [unroll]
    for (int k = 0; k < 9; k++)
    {
        int2 cell = base + int2(k % 3 - 1, k / 3 - 1);
        float2 toward = cell - base + HB_Random2(HB_WrapCell(cell, count), seed) - f;
        float2 split = toward - closest;

        if (dot(split, split) > 1e-6)
            edge = min(edge, dot((closest + toward) * 0.5, normalize(split)));
    }

    return edge;
}

float HB_StreakNoise(float2 uv, int2 period, uint seed)
{
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;

    [unroll]
    for (int octave = 0; octave < 3; octave++)
    {
        float2 p = uv * period;
        float2 lattice = floor(p);
        float2 t = p - lattice;
        int2 c = (int2)lattice;
        float2 w = t * t * (3.0 - 2.0 * t);
        uint s = seed + (uint)octave * 101u;

        float a = HB_Random((uint2)(c + period * WRAP) % (uint2)period, s);
        float b = HB_Random((uint2)(c + int2(1, 0) + period * WRAP) % (uint2)period, s);
        float d = HB_Random((uint2)(c + int2(0, 1) + period * WRAP) % (uint2)period, s);
        float e = HB_Random((uint2)(c + int2(1, 1) + period * WRAP) % (uint2)period, s);

        sum += lerp(lerp(a, b, w.x), lerp(d, e, w.x), w.y) * amplitude;
        total += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return sum / total;
}

float HB_StoneHeight(float2 uv, float4 cell, float floorHeight)
{
    int units = HB_UNITS;
    float edge = cell.x;
    float2 shape = cell.zw;
    uint key = HB_StoneKey(cell.y);
    float pixel = units * _Size.y;

    float rim = sin(saturate(edge / max(HB_BEVEL, pixel)) * PI * 0.5);
    float dome = 1.0 - saturate(dot(shape, shape));
    float facet = 1.0;
    float turn = HB_StoneRandom(key, 1u) * TAU;

    [unroll]
    for (int i = 0; i < FACETS; i++)
    {
        float angle = turn + i * (TAU / FACETS) + (HB_StoneRandom(key, 10u + i) - 0.5) * 0.6;
        float steep = 0.6 + 0.6 * HB_StoneRandom(key, 20u + i);

        facet = min(facet, 1.0 - steep * dot(shape, float2(cos(angle), sin(angle))));
    }

    float surface = lerp(dome, saturate(facet), HB_FACETS);
    float curve = HB_DOME < 0.0 ? HB_DOME : max(HB_DOME, HB_FACETS);
    float top = lerp(1.0, surface, curve) / (1.0 - min(curve, 0.0));
    float rise = 1.0 - HB_RISE_SPREAD * HB_StoneRandom(key, 2u);
    float lean = HB_StoneRandom(key, 3u) * TAU;
    float tilt = HB_TILT * 0.35 * dot(shape, float2(cos(lean), sin(lean)));
    float grain = (HB_Fbm(uv, units * 8, HB_SEED + 51u) - 0.5) * HB_ROUGHNESS * 0.3;

    return max(rim * saturate(rise * top + tilt + grain), floorHeight);
}
[numthreads(8, 8, 1)]
void Shape(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    float4 cell = _CellsIn[id.xy];
    float floorHeight = HB_Ground(uv);

    float grain = (HB_Fbm(uv, HB_UNITS * 8, HB_SEED + 51u) - 0.5) * HB_ROUGHNESS * 0.3;

    if (HB_FILL)
        _Height[id.xy] = 0.5 + floorHeight - _Ground.x * 0.5 + grain;
    else
        _Height[id.xy] = cell.x > 0.0 ? HB_StoneHeight(uv, cell, floorHeight) : floorHeight;
}
float HB_Ring(int2 texel, float radius)
{
    float sum = 0.0;

    [unroll]
    for (int tap = 0; tap < AO_TAPS; tap++)
    {
        float angle = tap * (TAU / AO_TAPS);
        int2 offset = (int2)round(float2(cos(angle), sin(angle)) * radius);

        sum += HB_GroundAt(texel + offset);
    }

    return sum / AO_TAPS;
}

[numthreads(8, 8, 1)]
void Derive(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    int2 texel = (int2)id.xy;
    float size = _Size.x;
    float scale = size / 256.0;
    float height = HB_HeightAt(texel);

    float left = HB_HeightAt(texel + int2(-1, 0));
    float right = HB_HeightAt(texel + int2(1, 0));
    float down = HB_HeightAt(texel + int2(0, -1));
    float up = HB_HeightAt(texel + int2(0, 1));

    float slope = HB_DEPTH * size * 0.5;
    float3 normal = normalize(float3((left - right) * slope, (down - up) * slope, 1.0));

    float reach = max(HB_LIGHT_WIDTH * scale, 1.0);
    float around = HB_Ring(texel, reach);
    float curve = (around - height) * HB_DEPTH * size / reach * CURVE_GAIN;
    float edge = saturate(-curve);
    float cavity = saturate(curve);

    float occlusion = 0.0;
    float radius = 2.0 * scale;

    [unroll]
    for (int ring = 0; ring < AO_RINGS; ring++)
    {
        occlusion += saturate((HB_Ring(texel, radius) - height) * HB_DEPTH * size / radius);
        radius *= 2.0;
    }

    float ao = saturate(1.0 - occlusion / AO_RINGS * AO_GAIN);

    _Detail[id.xy] = float4(edge, cavity, ao, 0.0);
    _NormalPreview[id.xy] = float4(1.0, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, normal.x * 0.5 + 0.5);
    _NormalExport[id.xy] = float4(normal * 0.5 + 0.5, 1.0);
}

[numthreads(8, 8, 1)]
void Compose(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    int units = HB_UNITS;
    float4 cell = _CellsIn[id.xy];
    float4 detail = _DetailIn[id.xy];
    float height = _HeightIn[id.xy];
    uint key = HB_StoneKey(cell.y);
    float pixel = units * _Size.y;
    float stone = saturate(cell.x / pixel + 0.5);

    float grain = (HB_Fbm(uv, units * 16, HB_SEED + 61u) - 0.5) * _StoneColour.w * 2.0;
    float3 rock = _StoneColour.rgb * (1.0 + grain);
    float3 ground = _GapColour.rgb * (1.0 + grain * 0.5);

    if (_VariationMore.y > 0.0)
    {
        float tone = 1.0 + _VariationColour.w * (HB_StoneRandom(key, 4u) - 0.5) * 2.0;
        float other = HB_StoneRandom(key, 5u) < _VariationMore.x ? 0.5 + 0.5 * HB_StoneRandom(key, 6u) : 0.0;

        rock = lerp(rock, _VariationColour.rgb * (1.0 + grain), other) * tone;

        if (HB_ORGANIC)
            ground *= 1.0 + (HB_Organic(uv, 3, HB_SEED + 95u) - 0.5) * _VariationColour.w * 2.0;
    }

    if (_VariationMore.y > 0.0)
    {
        float lift = 1.0 + _VariationMore.z * (height - 0.5);

        rock *= lift;
        ground *= lerp(1.0, lift, 0.5);
    }

    float3 albedo = saturate(lerp(ground, rock, stone));
    float smoothness = lerp(HB_GAP_SMOOTH, HB_SMOOTHNESS, stone);

    _Albedo[id.xy] = float4(albedo, 1.0);
    _Mask[id.xy] = float4(HB_METALLIC * stone, detail.z, height, smoothness);
}
struct HB_Mark
{
    float cover;
    float profile;
    float tone;
    float shade;
};

HB_Mark HB_MarkOf(float cover, float profile, float tone, float shade)
{
    HB_Mark mark;
    mark.cover = cover;
    mark.profile = profile;
    mark.tone = tone;
    mark.shade = shade;
    return mark;
}

float HB_MaskValue(int index, float2 uv, uint seed)
{
    float4 a = _MaskA[index];
    float4 b = _MaskB[index];
    int kind = (int)a.x;
    uint salt = seed + 50u + (uint)index * 13u;
    float2 bend = float2(HB_PerlinFbm(uv, 4, salt + 1u), HB_PerlinFbm(uv, 4, salt + 2u)) - 0.5;
    float2 at = frac(uv + bend * b.z * 0.1);
    int2 texel = HB_Wrap((int2)floor(at * HB_SIZE));
    float value = _HeightIn[texel];

    if (kind == MASK_EDGES)
        value = saturate(_DetailIn[texel].x * 3.0);
    else if (kind == MASK_CAVITIES)
        value = saturate(_DetailIn[texel].y * 3.0);
    else if (kind == MASK_NOISE)
        value = HB_PerlinFbm(at, max((int)b.y, 1), salt);
    else if (kind == MASK_PIECES)
        value = HB_Random(uint2(HB_StoneKey(_CellsIn[texel].y), 90u), salt);

    float soft = max(a.w, 0.001) * 0.5;
    float pick = smoothstep(a.z - soft, a.z + soft, value);

    return b.x > 0.5 ? 1.0 - pick : pick;
}

float HB_ModuleWhere(float2 uv, uint seed)
{
    int2 texel = HB_Wrap((int2)floor(uv * HB_SIZE));
    float stone = saturate(_CellsIn[texel].x / (HB_UNITS * _Size.y) + 0.5);
    int area = (int)_ModuleWhere.x;
    float where = area == AREA_PIECES ? stone : area == AREA_JOINTS ? 1.0 - stone : 1.0;
    int count = min((int)_ModuleMask.x, MASKS);
    float mask = 1.0;

    [loop]
    for (int i = 0; i < count; i++)
    {
        float value = HB_MaskValue(i, uv, seed);
        int combine = (int)_MaskA[i].y;

        if (i == 0)
            mask = value;
        else if (combine == COMBINE_ADD)
            mask = saturate(mask + value);
        else if (combine == COMBINE_SUBTRACT)
            mask = saturate(mask - value);
        else
            mask *= value;
    }

    return where * mask;
}
float2 HB_ModuleCracks(float2 uv, float amount, int scale, float size, uint seed)
{
    float2 jag = float2(HB_PerlinFbm(uv, scale * 4, seed + 1u), HB_PerlinFbm(uv, scale * 4, seed + 2u)) - 0.5;
    float edge = HB_CellEdge(uv * scale + jag * 0.45, scale, seed);
    float reach = HB_PerlinFbm(uv, max((int)((uint)scale / 2u), 1), seed + 3u);
    float start = lerp(0.72, 0.3, amount);
    float open = smoothstep(start, start + 0.15, reach);
    float width = max(scale * _Size.y, (0.005 + 0.05 * size) * open);
    float crack = saturate(open * 2.0) * (1.0 - smoothstep(width * 0.4, width, edge));

    return float2(crack, crack);
}

float2 HB_ModuleScratches(float2 uv, float amount, int scale, float size, uint seed)
{
    float2 p = uv * scale;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float pixel = scale * _Size.y;
    float mark = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(cell, scale);

        if (HB_Random(wrapped, seed) >= amount)
            continue;

        float2 centre = cell - base + HB_Random2(wrapped, seed + 1u);
        float angle = HB_Random(wrapped, seed + 2u) * PI;
        float reach = (0.1 + 0.9 * size) * (0.4 + 0.6 * HB_Random(wrapped, seed + 3u));
        float2 direction = float2(cos(angle), sin(angle));
        float2 toward = f - centre;
        float along = clamp(dot(toward, direction), -reach, reach);
        float fade = 1.0 - abs(along) / reach;
        float width = max(pixel, (0.0015 + 0.0015 * fade) * scale);
        float stroke = 1.0 - smoothstep(width * 0.5, width, length(toward - direction * along));

        mark = max(mark, stroke * saturate(fade * 3.0) * (0.4 + 0.6 * HB_Random(wrapped, seed + 4u)));
    }

    return float2(mark, mark);
}

float2 HB_ModuleStreaks(float2 uv, float amount, int scale, float size, uint seed)
{
    int stretch = 1 + (int)round(size * 15.0);
    int2 period = int2(scale, max((int)((uint)scale / (uint)stretch), 1));
    float start = lerp(0.68, 0.35, amount);
    float streak = smoothstep(start, start + 0.2, HB_StreakNoise(uv, period, seed));

    return float2(streak, streak);
}

HB_Mark HB_ModuleWood(uint2 texel, float4 cell, float amount, int scale, float size, float knots, uint seed)
{
    float rings = 0.0;
    float fibres = 0.0;
    float knot = 0.0;

    HB_WoodGrain(_FrameIn[texel], HB_StoneKey(cell.y), scale, knots, seed, rings, fibres, knot);

    float streak = saturate(rings * amount + (fibres - 0.3) * size * 0.8);
    float profile = rings * amount * 0.6 + fibres * size * 0.4 - knot * 0.3;

    return HB_MarkOf(max(streak, knot), profile, fibres, lerp(1.0, 0.6, knot));
}

HB_Mark HB_ModuleChips(float2 uv, float4 cell, float amount, int scale, float size, uint seed)
{
    if (cell.x <= 0.0)
        return HB_MarkOf(0.0, 0.0, 0.5, 1.0);

    float2 p = uv * scale;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float pixel = scale * _Size.y;
    float reach = 0.02 + 0.28 * size;
    float chip = 0.0;

    [unroll]
    for (uint j = 0u; j < 9u; j++)
    {
        int2 near = base + int2((int)(j % 3u) - 1, (int)(j / 3u) - 1);
        uint2 wrapped = HB_WrapCell(near, scale);

        if (HB_Random(wrapped, seed) >= amount)
            continue;

        float2 spot = HB_Random2(wrapped, seed + 1u);
        float4 at = _CellsIn[HB_Wrap((int2)((float2(wrapped) + spot) / scale * HB_SIZE))];

        if (abs(at.y - cell.y) > 1e-6 || at.x <= 0.0 || (!HB_FILL && at.x > reach * 0.7))
            continue;

        float2 toward = f - (near - base + spot);
        float wobble = 1.0 + 0.25 * sin(atan2(toward.y, toward.x) * 3.0 + HB_Random(wrapped, seed + 3u) * TAU);
        float radius = reach * scale / max(HB_UNITS, 1) * (0.6 + 0.5 * HB_Random(wrapped, seed + 2u)) * wobble;

        radius = min(radius, 0.9);
        chip = max(chip, smoothstep(0.0, max(radius * 0.35, pixel), radius - length(toward)));
    }

    float broken = 0.6 + 0.4 * HB_PerlinFbm(uv, scale * 4, seed + 9u);
    float slope = HB_FILL ? 1.0 : lerp(0.3, 1.0, saturate(1.0 - cell.x / max(reach, 1e-3)));
    float tone = saturate((HB_Fbm(uv, scale * 2, seed + 7u) - 0.5) * 3.0 + 0.5);

    return HB_MarkOf(chip, chip * slope * broken, tone, 1.0);
}

HB_Mark HB_ModuleClumps(float2 uv, float amount, int scale, float size, float blades, uint seed)
{
    float pixel = scale * _Size.y;
    HB_Mark mark = HB_MarkOf(0.0, 0.0, 0.5, 1.0);

    [loop]
    for (int grid = 0; grid < 2; grid++)
    {
        float shift = grid * 0.5;
        uint salt = seed + (uint)grid * 31u;
        float2 p = uv * scale + shift;
        int2 base = (int2)floor(p);
        float2 f = p - base;

        [loop]
        for (uint j = 0u; j < 9u; j++)
        {
            int2 cell = base + int2((int)(j % 3u) - 1, (int)(j / 3u) - 1);
            uint2 wrapped = HB_WrapCell(cell, scale);

            if (HB_Random(wrapped, salt) >= amount)
                continue;

            float2 spot = HB_Random2(wrapped, salt + 1u);
            float2 toward = f - (cell - base + spot);
            float radius = (0.15 + 0.8 * size) * (0.7 + 0.3 * HB_Random(wrapped, salt + 2u));
            float distance = length(toward);

            if (distance >= radius)
                continue;

            float where = HB_ModuleWhere(frac((float2(wrapped) + spot - shift) / scale), seed);
            float reach = distance / radius;
            float dome = sqrt(1.0 - reach * reach) * (0.6 + 0.4 * HB_Random(wrapped, salt + 3u));
            float count = 7.0 + floor(HB_Random(wrapped, salt + 4u) * 6.0);
            float twist = HB_Random(wrapped, salt + 5u) * TAU + reach * 1.5;
            float blade = pow(abs(cos((atan2(toward.y, toward.x) + twist) * count * 0.5)), 6.0 + reach * 20.0);
            float tuft = saturate(blade * 1.5) * (1.0 - reach) * (0.5 + 0.3 * HB_Random(wrapped, salt + 6u));
            float top = lerp(dome, tuft, blades) * where;

            if (top <= mark.profile)
                continue;

            float cover = lerp(saturate((radius - distance) / pixel), saturate(tuft * 20.0), blades) * where;

            mark = HB_MarkOf(cover, top, HB_Random(wrapped, salt + 7u), lerp(1.0, 0.55 + tuft * 0.9, blades));
        }
    }

    return mark;
}
HB_Mark HB_ModuleLeaves(float2 uv, float amount, int scale, float size, float twigs, uint seed)
{
    float2 p = uv * scale;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float pixel = scale * _Size.y;
    float order = -1.0;
    HB_Mark mark = HB_MarkOf(0.0, 0.0, 0.5, 1.0);

    [loop]
    for (uint j = 0u; j < 9u; j++)
    {
        int2 cell = base + int2((int)(j % 3u) - 1, (int)(j / 3u) - 1);
        uint2 wrapped = HB_WrapCell(cell, scale);

        if (HB_Random(wrapped, seed) >= amount)
            continue;

        float layer = HB_Random(wrapped, seed + 6u);

        if (layer <= order)
            continue;

        float angle = HB_Random(wrapped, seed + 2u) * TAU;
        float2 direction = float2(cos(angle), sin(angle));
        float2 spot = HB_Random2(wrapped, seed + 1u);
        float2 toward = f - (cell - base + spot);
        float2 local = float2(dot(toward, direction), dot(toward, float2(-direction.y, direction.x)));
        bool twig = HB_Random(wrapped, seed + 3u) < twigs;
        float span = (0.15 + 0.14 * HB_Random(wrapped, seed + 4u)) * (0.5 + size);
        float cover;
        float rib;

        if (twig)
        {
            float reach = min(span * 2.0, 0.95);
            float along = clamp(local.x, -reach, reach);
            float width = pixel * 1.2 + 0.012;

            cover = 1.0 - smoothstep(width * 0.6, width, distance(local, float2(along, 0.0)));
            rib = 0.0;
        }
        else
        {
            float x = local.x / span;
            float curl = local.y + x * x * span * (HB_Random(wrapped, seed + 5u) - 0.5) * 0.3;
            float girth = span * 0.45 * (1.0 - x * x);

            cover = abs(x) < 1.0 ? saturate((girth - abs(curl)) / pixel) : 0.0;
            rib = 1.0 - saturate(abs(curl) / (pixel * 0.8));
        }

        if (cover <= 0.0)
            continue;

        float where = HB_ModuleWhere((float2(wrapped) + spot) / scale, seed);

        if (where <= 0.0)
            continue;

        order = layer;
        mark = HB_MarkOf(cover * where, cover * where * (twig ? 1.0 : 0.7), HB_Random(wrapped, seed + 7u),
                         twig ? 0.45 : 1.0 - rib * 0.2);
    }

    return mark;
}

HB_Mark HB_ModuleShape(float2 uv, uint2 texel, float4 cell, int shape, float amount, int scale, float size,
                       uint seed)
{
    if (shape == SHAPE_WOOD)
        return HB_ModuleWood(texel, cell, amount, scale, size, _ModuleSurface.z, seed);

    if (shape == SHAPE_CHIPS)
        return HB_ModuleChips(uv, cell, amount, scale, size, seed);

    if (shape == SHAPE_CLUMPS)
        return HB_ModuleClumps(uv, amount, scale, size, _ModuleSurface.z, seed);

    if (shape == SHAPE_LEAVES)
        return HB_ModuleLeaves(uv, amount, scale, size, _ModuleSurface.z, seed);

    float2 plain = float2(amount, 1.0);

    if (shape == SHAPE_CRACKS)
        plain = HB_ModuleCracks(uv, amount, scale, size, seed);
    else if (shape == SHAPE_SCRATCHES)
        plain = HB_ModuleScratches(uv, amount, scale, size, seed);
    else if (shape == SHAPE_STREAKS)
        plain = HB_ModuleStreaks(uv, amount, scale, size, seed);

    return HB_MarkOf(plain.x, plain.y, saturate((HB_Fbm(uv, scale * 2, seed + 7u) - 0.5) * 3.0 + 0.5), 1.0);
}

[numthreads(8, 8, 1)]
void Module(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    uint seed = HB_SEED * 7919u + (uint)_ModuleShape.w * 104729u;
    int shape = (int)_ModuleShape.x;
    float amount = _ModuleShape.y;
    int scale = max((int)_ModuleShape.z, 1);
    float size = _ModuleMore.x;
    float4 cell = _CellsIn[id.xy];
    float height = _HeightIn[id.xy];
    float4 colour = _Albedo[id.xy];
    float4 material = _Mask[id.xy];
    bool placed = shape == SHAPE_CLUMPS || shape == SHAPE_LEAVES;
    float where = placed ? 1.0 : HB_ModuleWhere(uv, seed);

    HB_Mark mark = HB_ModuleShape(uv, id.xy, cell, shape, amount, scale, size, seed);
    float cover = saturate(mark.cover * where);

    if (cover <= 0.0)
        return;

    float tone = 1.0 + (mark.tone - 0.5) * 2.0 * _ModuleMore.y;
    int mode = (int)_ModuleMore.z;
    float relief = _ModuleMore.w * mark.profile * where;
    float paint = cover;

    if (mode == HEIGHT_FLATTEN)
        paint *= saturate((_ModuleMore.w - height) / 0.02 + 0.5);

    colour.rgb = lerp(colour.rgb, saturate(_ModuleColour.rgb * tone * mark.shade), paint * _ModuleColour.a);
    material.r = lerp(material.r, _ModuleSurface.y, paint);
    material.a = lerp(material.a, _ModuleSurface.x, paint);

    if (mode == HEIGHT_CUT)
    {
        height -= relief;
    }
    else if (mode == HEIGHT_RAISE)
    {
        height += relief;
        _Lift[id.xy] += relief;
    }
    else if (mode == HEIGHT_FLATTEN)
        height = lerp(height, max(height, _ModuleMore.w), cover);

    _Albedo[id.xy] = colour;
    _Mask[id.xy] = material;
    _Height[id.xy] = height;
}

[numthreads(8, 8, 1)]
void Light(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float4 detail = _DetailIn[id.xy];
    float4 colour = _Albedo[id.xy];
    float4 material = _Mask[id.xy];
    float light = 1.0 + detail.x * HB_EDGE_LIGHT - detail.y * HB_CAVITY_DARK;

    _Albedo[id.xy] = float4(saturate(colour.rgb * light * lerp(1.0, detail.z, HB_AO_BAKE)), 1.0);
    _Mask[id.xy] = float4(material.r, detail.z, _HeightIn[id.xy], material.a);
}

float3 HB_ToDisplay(float3 value)
{
    return pow(saturate(value), 2.2);
}

[numthreads(8, 8, 1)]
void Show(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float4 detail = _DetailIn[id.xy];
    float3 colour;

    if (_ShowMode == 0)
        colour = _AlbedoIn[id.xy].rgb;
    else if (_ShowMode == 1)
        colour = HB_ToDisplay(_NormalIn[id.xy].rgb);
    else if (_ShowMode == 2)
        colour = HB_ToDisplay(_MaskIn[id.xy].rgb);
    else if (_ShowMode == 3)
        colour = HB_ToDisplay(_HeightIn[id.xy].xxx);
    else if (_ShowMode == 4)
        colour = HB_ToDisplay(detail.zzz);
    else
        colour = HB_ToDisplay(0.5 + (detail.x - detail.y) * 0.5).xxx;

    _Display[id.xy] = float4(colour, 1.0);
}

float3 HB_LinearToSrgb(float3 value)
{
    value = saturate(value);

    return value <= 0.0031308 ? value * 12.92 : 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

[numthreads(8, 8, 1)]
void Encode(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    _Encoded[id.xy] = float4(HB_LinearToSrgb(_AlbedoIn[id.xy].rgb), 1.0);
}

[numthreads(8, 8, 1)]
void Composite(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float4 colour = _AlbedoIn[id.xy];
    float4 material = _MaskIn[id.xy];
    float height = _HeightIn[id.xy];

    if (_Blend.y < 0.5)
    {
        float below = _BelowHeight[id.xy];
        float cover = saturate(_Blend.x);

        if (_Blend.z > 0.5)
        {
            height += _BlendMore.x;
            cover *= saturate((height - below) * lerp(2.0, 60.0, _Blend.w) + 0.5);
        }

        colour = lerp(_BelowAlbedo[id.xy], colour, cover);
        material = lerp(_BelowMask[id.xy], material, cover);
        height = lerp(below, height, cover);
        material.z = height;
    }

    _Albedo[id.xy] = colour;
    _Mask[id.xy] = material;
    _StackHeight[id.xy] = height;
}
