#define PI           3.14159265
#define TAU          6.28318531
#define AO_RINGS     4
#define AO_TAPS      8
#define CURVE_GAIN   0.5
#define AO_GAIN      2.0
#define FACETS       7
#define WRAP         64
#define WIDE         4096
#define KNOTS        2

#define KIND_VORONOI     0
#define KIND_COURSES     1
#define KIND_HERRINGBONE 2
