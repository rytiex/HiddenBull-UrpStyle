int _ShowMode;

#define HB_SIZE         ((int)_Size.x)
#define HB_KIND         ((int)_Layout.x)
#define HB_UNITS        ((int)_Layout.y)
#define HB_JITTER       _Layout.z
#define HB_PER_ROW      ((int)_Layout.w)
#define HB_GAP          _Joint.x
#define HB_ROUNDNESS    _Joint.y
#define HB_CHIPPING     _Joint.z
#define HB_ROW_OFFSET   _Joint.w
#define HB_RANDOM_SHIFT (_Pattern.x > 0.5)
#define HB_LENGTH       ((int)_Pattern.y)
#define HB_WOOD         (_Pattern.z > 0.5)
#define HB_BEVEL        _Shape.x
#define HB_DOME         _Shape.y
#define HB_FACETS       _Shape.z
#define HB_RISE_SPREAD  _Shape.w
#define HB_TILT         _ShapeMore.x
#define HB_ROUGHNESS    _ShapeMore.y
#define HB_SEED         ((uint)_ShapeMore.z)
#define HB_RINGS        _Wood.x
#define HB_RING_DENSITY _Wood.y
#define HB_FIBRES       _Wood.z
#define HB_KNOTS        _Wood.w
#define HB_WOOD_RELIEF  _GrainColour.w
#define HB_DEPTH        _Surface.x
#define HB_SMOOTHNESS   _Surface.y
#define HB_GAP_SMOOTH   _Surface.z
#define HB_METALLIC     _Surface.w
#define HB_EDGE_LIGHT   _Light.x
#define HB_CAVITY_DARK  _Light.y
#define HB_AO_BAKE      _Light.z
#define HB_LIGHT_WIDTH  _Light.w
#define HB_ROUGH_SMOOTH 0.08
#define HB_DENSITY      _Scatter.x
#define HB_PEBBLE       _Scatter.y
#define HB_ELONGATION   _Scatter.z
#define HB_FINE_CRACKS  _Scatter.w
#define HB_ORGANIC      (_Pattern.w > 0.5)
#define HB_HAIR         _Details.x
#define HB_HAIR_SCALE   ((int)_Details.y)
#define HB_CHIPS        _Details.z
#define HB_CHIP_SIZE    _Details.w
#define HB_SCRATCHES    _DetailsMore.x
#define HB_SCRATCH_SCALE ((int)_DetailsMore.y)
#define HB_JOINT_PEBBLES _DetailsMore.z
#define HB_JOINT_GRASS  _DetailsMore.w

struct HB_Piece
{
    float edge;
    float2 offset;
    uint2 key;
    float4 frame;
};

uint HB_Hash(uint2 cell, uint seed)
{
    uint value = cell.x * 73856093u ^ cell.y * 19349663u ^ seed * 83492791u;

    value ^= value >> 13;
    value *= 0x5bd1e995u;
    value ^= value >> 15;

    return value;
}

float HB_Random(uint2 cell, uint seed)
{
    return (HB_Hash(cell, seed) & 0xFFFFu) / 65535.0;
}

float2 HB_Random2(uint2 cell, uint seed)
{
    return float2(HB_Random(cell, seed), HB_Random(cell, seed + 7919u));
}

uint2 HB_WrapCell(int2 cell, int count)
{
    return (uint2)(cell + count * WRAP) % (uint)count;
}

int2 HB_Wrap(int2 texel)
{
    int size = HB_SIZE;

    return (int2)((uint2)(texel + size * 4) % (uint)size);
}

float HB_HeightAt(int2 texel)
{
    return _HeightIn[HB_Wrap(texel)];
}

float2 HB_Uv(uint2 id)
{
    return (id + 0.5) * _Size.y;
}

float HB_Noise(float2 p, int period, uint seed)
{
    float2 lattice = floor(p);
    float2 f = p - lattice;
    int2 c = (int2)lattice;

    f = f * f * (3.0 - 2.0 * f);

    float a = HB_Random(HB_WrapCell(c, period), seed);
    float b = HB_Random(HB_WrapCell(c + int2(1, 0), period), seed);
    float d = HB_Random(HB_WrapCell(c + int2(0, 1), period), seed);
    float e = HB_Random(HB_WrapCell(c + int2(1, 1), period), seed);

    return lerp(lerp(a, b, f.x), lerp(d, e, f.x), f.y);
}

float HB_Fbm(float2 uv, int period, uint seed)
{
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;

    period = max(period, 1);

    [unroll]
    for (int octave = 0; octave < 4; octave++)
    {
        sum += HB_Noise(uv * period, period, seed + (uint)octave * 101u) * amplitude;
        total += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return sum / total;
}

float2 HB_Gradient(int2 cell, int period, uint seed)
{
    float angle = HB_Random(HB_WrapCell(cell, period), seed) * TAU;

    return float2(cos(angle), sin(angle));
}

float HB_Perlin(float2 p, int period, uint seed)
{
    float2 lattice = floor(p);
    float2 f = p - lattice;
    int2 c = (int2)lattice;
    float2 w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float a = dot(HB_Gradient(c, period, seed), f);
    float b = dot(HB_Gradient(c + int2(1, 0), period, seed), f - float2(1.0, 0.0));
    float d = dot(HB_Gradient(c + int2(0, 1), period, seed), f - float2(0.0, 1.0));
    float e = dot(HB_Gradient(c + int2(1, 1), period, seed), f - 1.0);

    return lerp(lerp(a, b, w.x), lerp(d, e, w.x), w.y) * 0.7 + 0.5;
}

float HB_PerlinFbm(float2 uv, int period, uint seed)
{
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;

    period = max(period, 1);

    [unroll]
    for (int octave = 0; octave < 5; octave++)
    {
        sum += HB_Perlin(uv * period, period, seed + (uint)octave * 101u) * amplitude;
        total += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return sum / total;
}

float HB_Organic(float2 uv, int period, uint seed)
{
    float2 warp = float2(HB_PerlinFbm(uv, period, seed + 1u), HB_PerlinFbm(uv, period, seed + 2u)) - 0.5;

    return HB_PerlinFbm(uv + warp * 0.5 / max(period, 1), period, seed);
}

float HB_SoftMin(float a, float b, float k)
{
    float low = min(a, b);

    return low - k * log(exp((low - a) / k) + exp((low - b) / k));
}

float HB_BoxEdge(float2 local, float2 size, float soft)
{
    return HB_SoftMin(min(local.x, size.x - local.x), min(local.y, size.y - local.y), soft);
}

float2 HB_Point(int2 cell, int count, uint seed)
{
    return 0.5 + (HB_Random2(HB_WrapCell(cell, count), seed) - 0.5) * HB_JITTER;
}

HB_Piece HB_Voronoi(float2 p, int count, uint seed, float soft)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float best = 1e9;
    int2 bestCell = 0;
    float2 bestVector = 0.0;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            int2 cell = int2(x, y);
            float2 toward = cell + HB_Point(base + cell, count, seed) - f;
            float distance = dot(toward, toward);

            if (distance < best)
            {
                best = distance;
                bestCell = cell;
                bestVector = toward;
            }
        }
    }

    float hard = 1e9;
    float distances[25];

    [unroll]
    for (int j = 0; j < 25; j++)
    {
        int2 cell = bestCell + int2(j % 5 - 2, j / 5 - 2);
        float2 toward = cell + HB_Point(base + cell, count, seed) - f;
        float2 across = toward - bestVector;

        distances[j] = dot(across, across) > 1e-6
            ? dot(0.5 * (bestVector + toward), normalize(across))
            : 1e9;
        hard = min(hard, distances[j]);
    }

    float sum = 0.0;

    [unroll]
    for (int k = 0; k < 25; k++)
        sum += exp((hard - distances[k]) / soft);

    HB_Piece piece;
    piece.edge = hard - soft * log(sum);
    piece.offset = -bestVector;
    piece.key = HB_WrapCell(base + bestCell, count);
    piece.frame = float4(-bestVector.x + 0.5, -bestVector.y + 0.5, 0.0, 1.0);
    return piece;
}

float HB_Joint(int column, uint row, int perRow, float stretch, uint seed)
{
    uint wrapped = HB_WrapCell(int2(column, 0), perRow).x;

    return (column + (HB_Random(uint2(wrapped, row), seed + 97u) - 0.5) * HB_JITTER * 0.8) * stretch;
}

HB_Piece HB_Courses(float2 p, int rows, int perRow, float soft, uint seed)
{
    float stretch = rows / (float)perRow;
    int row = (int)floor(p.y);
    uint course = HB_WrapCell(int2(row, 0), rows).x;
    float shift = HB_RANDOM_SHIFT
        ? HB_Random(uint2(course, 91u), seed) * stretch
        : ((course & 1u) != 0u ? HB_ROW_OFFSET * stretch : 0.0);
    float along = p.x + shift;
    int first = (int)floor(along / stretch);
    int column = first;
    float start = first * stretch;
    float end = start + stretch;

    [unroll]
    for (int k = -1; k <= 1; k++)
    {
        float a = HB_Joint(first + k, course, perRow, stretch, seed);
        float b = HB_Joint(first + k + 1, course, perRow, stretch, seed);

        if (along >= a && along < b)
        {
            column = first + k;
            start = a;
            end = b;
        }
    }

    float2 size = float2(end - start, 1.0);
    float2 local = float2(along - start, p.y - row);

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = uint2(HB_WrapCell(int2(column, 0), perRow).x, course);
    piece.frame = float4(local.x, local.y, 0.0, size.x);
    return piece;
}

HB_Piece HB_Herringbone(float2 p, int length, int period, float soft)
{
    float2 guess = float2((p.x + p.y) * 0.5, (p.x - p.y) / (2.0 * length));
    int2 base = (int2)floor(guess);
    float2 local = 0.0;
    float2 size = float2(length, 1.0);
    float2 centre = 0.0;
    float upright = 0.0;

    [loop]
    for (int i = -3; i <= 3; i++)
    {
        [unroll]
        for (int j = -2; j <= 2; j++)
        {
            int2 lattice = base + int2(i, j);
            float2 origin = float2(lattice.x + length * lattice.y, lattice.x - length * lattice.y);
            float2 q = p - origin;

            if (q.x >= 0.0 && q.x < length && q.y >= 0.0 && q.y < 1.0)
            {
                local = q;
                size = float2(length, 1.0);
                centre = origin + size * 0.5;
                upright = 0.0;
            }
            else if (q.x >= 0.0 && q.x < 1.0 && q.y >= 1.0 && q.y < 1.0 + length)
            {
                local = q - float2(0.0, 1.0);
                size = float2(1.0, length);
                centre = origin + float2(0.5, 1.0 + length * 0.5);
                upright = 1.0;
            }
        }
    }

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = HB_WrapCell((int2)floor(centre * 2.0), period * 2) + uint2((uint)upright * 65536u, 0u);
    piece.frame = upright > 0.5
        ? float4(local.y, local.x, 1.0, size.y)
        : float4(local.x, local.y, 0.0, size.x);
    return piece;
}

HB_Piece HB_Basket(float2 p, int length, int squares, float soft)
{
    int2 square = (int2)floor(p / length);
    uint2 wrapped = HB_WrapCell(square, squares);
    float2 inside = p - square * length;
    bool lying = ((wrapped.x + wrapped.y) & 1u) == 0u;
    float brick = floor(lying ? inside.y : inside.x);
    float2 local = lying ? float2(inside.x, inside.y - brick) : float2(inside.x - brick, inside.y);
    float2 size = lying ? float2(length, 1.0) : float2(1.0, length);

    HB_Piece piece;
    piece.edge = HB_BoxEdge(local, size, soft);
    piece.offset = local - size * 0.5;
    piece.key = uint2(wrapped.x * 16u + (uint)brick, wrapped.y);
    piece.frame = lying ? float4(local.x, local.y, 0.0, length) : float4(local.y, local.x, 1.0, length);
    return piece;
}

void HB_ScatterPass(float2 p, int count, float size, uint seed, float unit, uint tag, inout float best,
                    inout float nearest, inout HB_Piece piece)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(cell, count);

        if (HB_Random(wrapped, seed + 5u) >= HB_DENSITY)
            continue;

        float2 centre = cell - base + HB_Point(cell, count, seed);
        float turn = HB_Random(wrapped, seed + 6u) * TAU;
        float stretch = 1.0 + HB_Random(wrapped, seed + 8u) * HB_ELONGATION;
        float pick = HB_Random(wrapped, seed + 9u);
        float radius = size * (0.4 + 0.6 * pick * pick);
        float2 toward = f - centre;
        float2 turned = float2(dot(toward, float2(cos(turn), sin(turn))),
                               dot(toward, float2(-sin(turn), cos(turn))) * stretch);
        float distance = length(turned);
        float angle = atan2(turned.y, turned.x);
        float lobes = sin(angle * 2.0 + HB_Random(wrapped, seed + 12u) * TAU) * 0.5 +
                      sin(angle * 3.0 + HB_Random(wrapped, seed + 13u) * TAU) * 0.3 +
                      sin(angle * 5.0 + HB_Random(wrapped, seed + 14u) * TAU) * 0.2;

        radius *= 1.0 + (0.15 + HB_CHIPPING * 0.3) * lobes;

        float edge = (radius - distance) * unit;

        nearest = max(nearest, edge);

        if (edge <= 0.0)
            continue;

        uint2 key = wrapped + uint2(0u, tag);
        uint stone = HB_Hash(key, HB_SEED + 3u) & 0xFFFFFFu;
        float rise = 1.0 - HB_RISE_SPREAD * HB_Random(uint2(stone, 2u), HB_SEED);
        float score = rise * (1.0 - distance * distance / (radius * radius));

        if (score > best)
        {
            best = score;
            piece.edge = edge;
            piece.offset = turned * unit;
            piece.key = key;
            piece.frame = float4((turned + radius) * unit, 0.0, radius * 2.0 * unit);
        }
    }
}

HB_Piece HB_Scatter(float2 p, int count, uint seed)
{
    float best = -1.0;
    float nearest = -1e9;

    HB_Piece piece;
    piece.edge = -1.0;
    piece.offset = 0.0;
    piece.key = 0u;
    piece.frame = float4(0.0, 0.0, 0.0, 1.0);

    HB_ScatterPass(p, count, HB_PEBBLE, seed, 1.0, 0u, best, nearest, piece);

    if (best < 0.0)
        HB_ScatterPass(p * 3.0, count * 3, HB_PEBBLE * 0.45, seed + 200u, 1.0 / 3.0, 0x10000u, best, nearest,
                       piece);

    if (best < 0.0)
        piece.edge = nearest;

    return piece;
}

[numthreads(8, 8, 1)]
void Cells(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    int units = HB_UNITS;
    uint seed = HB_SEED;
    float soft = max(HB_ROUNDNESS * 0.15, 0.002);

    float2 warp = float2(HB_Fbm(uv, units * 2, seed + 11u), HB_Fbm(uv, units * 2, seed + 23u)) - 0.5;
    float2 p = uv * units + warp * HB_CHIPPING * 0.6;

    HB_Piece piece;

    if (HB_KIND == KIND_COURSES)
        piece = HB_Courses(p, units, HB_PER_ROW, soft, seed);
    else if (HB_KIND == KIND_HERRINGBONE)
        piece = HB_Herringbone(p, HB_LENGTH, units, soft);
    else if (HB_KIND == KIND_SCATTER)
        piece = HB_Scatter(p, units, seed);
    else if (HB_KIND == KIND_BASKET)
        piece = HB_Basket(p, HB_LENGTH, (int)((uint)units / (uint)max(HB_LENGTH, 1)), soft);
    else
    {
        piece = HB_Voronoi(p, units, seed, soft);

        if (HB_FINE_CRACKS > 0.0)
        {
            int finePeriod = units * 8;
            float2 jag = float2(HB_PerlinFbm(uv, finePeriod, seed + 501u), HB_PerlinFbm(uv, finePeriod, seed + 502u));
            HB_Piece fine = HB_Voronoi(p * 2.0 + (jag - 0.5) * 0.5, units * 2, seed + 500u, 0.002);
            float reach = HB_PerlinFbm(uv, units * 3, seed + 503u);
            float start = lerp(0.72, 0.3, HB_FINE_CRACKS);
            float open = smoothstep(start, start + 0.12, reach);
            float fade = (1.0 - open) * (HB_BEVEL + 0.02) * 2.0;

            piece.edge = min(piece.edge, fine.edge * 0.5 + HB_GAP * 0.5 - HB_GAP * 0.3 * open + fade);
        }
    }

    float edge = piece.edge + (HB_Fbm(uv, units * 8, seed + 31u) - 0.5) * HB_CHIPPING * 0.08;
    float2 shape = piece.offset / (length(piece.offset) + max(edge, 1e-4));
    float stone = (HB_Hash(piece.key, seed + 3u) & 0xFFFFFFu) / 16777215.0;

    _Cells[id.xy] = float4(edge - HB_GAP * 0.5, stone, shape);
    _Frame[id.xy] = piece.frame;
}

uint HB_StoneKey(float stone)
{
    return (uint)(stone * 16777215.0 + 0.5);
}

float HB_StoneRandom(uint key, uint salt)
{
    return HB_Random(uint2(key, salt), HB_SEED);
}

void HB_WoodGrain(float4 frame, uint key, out float rings, out float fibres, out float knot)
{
    float along = frame.x;
    float across = frame.y;
    uint seed = HB_SEED + 5003u;
    float phase = HB_StoneRandom(key, 30u) * 300.0;

    float bend = (HB_Noise(float2(along * 0.35 + phase, 0.5), WIDE, seed) - 0.5) * 0.8;
    float wobble = (HB_Noise(float2(along * 1.5 + phase, across * 3.0), WIDE, seed + 1u) - 0.5) * 0.15;
    float wave = across + bend + wobble;

    knot = 0.0;

    [unroll]
    for (int k = 0; k < KNOTS; k++)
    {
        uint salt = 32u + (uint)k * 5u;
        float chance = HB_KNOTS * (k == 0 ? 1.0 : 0.4);

        if (HB_StoneRandom(key, salt) >= chance)
            continue;

        float2 centre = float2(HB_StoneRandom(key, salt + 1u) * frame.w, 0.2 + 0.6 * HB_StoneRandom(key, salt + 2u));
        float radius = 0.06 + 0.08 * HB_StoneRandom(key, salt + 3u);
        float2 reach = float2((along - centre.x) / (radius * 3.0), (across - centre.y) / (radius * 1.6));

        wave += (across - centre.y) * exp(-dot(reach, reach)) * 1.5;
        knot = max(knot, saturate(1.0 - length(float2(along - centre.x, across - centre.y)) / radius));
    }

    float ring = frac(wave * HB_RING_DENSITY);

    rings = smoothstep(0.6, 1.0, 1.0 - abs(ring * 2.0 - 1.0));
    fibres = HB_Noise(float2(along * 2.0 + phase, across * 40.0), WIDE, seed + 2u);
}

float HB_OrganicGround(float2 uv, int period)
{
    float lumps = HB_Organic(uv, period, HB_SEED + 41u);
    float grit = HB_PerlinFbm(uv, period * 8, HB_SEED + 47u) - 0.5;

    lumps = saturate(lumps + grit * 0.12);

    int count = max((int)_Ground.w, 1);
    float bend = (HB_PerlinFbm(uv, 2, HB_SEED + 43u) - 0.5) * 3.0 + (HB_PerlinFbm(uv, 5, HB_SEED + 44u) - 0.5) +
                 (lumps - 0.5) * 0.5;
    float wave = frac(uv.x * count + bend * _GroundMore.x * 2.0);
    float ripple = smoothstep(0.0, 1.0, wave < 0.75 ? wave / 0.75 : (1.0 - wave) / 0.25);
    float strength = smoothstep(0.25, 0.75, HB_PerlinFbm(uv, 3, HB_SEED + 45u)) * 0.7 + 0.3;
    float fineBend = (HB_PerlinFbm(uv, 4, HB_SEED + 46u) - 0.5) * 2.0 + bend * 0.5;
    float fine = frac((uv.x * 3.0 + uv.y) * count + fineBend * _GroundMore.x * 2.0);
    float shaped = ripple * strength * 0.75 + (1.0 - abs(fine * 2.0 - 1.0)) * 0.1 + lumps * 0.25;

    return _Ground.x * lerp(lumps, shaped, saturate(_Ground.z));
}

float HB_Ground(float2 uv)
{
    return HB_ORGANIC ? HB_OrganicGround(uv, (int)_Ground.y) : HB_Fbm(uv, (int)_Ground.y, HB_SEED + 41u) * _Ground.x;
}

float HB_Specks(float2 uv, uint seed)
{
    int count = max((int)_SpecksMore.x, 1);
    float2 p = uv * count;
    int2 cell = (int2)floor(p);
    float specks = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 near = cell + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(near, count);

        if (HB_Random(wrapped, seed) >= _Specks.w)
            continue;

        float2 centre = near + HB_Random2(wrapped, seed + 1u);
        float radius = 0.2 + 0.25 * HB_Random(wrapped, seed + 2u);
        float pixel = count * _Size.y;

        specks = max(specks, saturate((radius - length(p - centre)) / pixel + 0.5));
    }

    return specks;
}

float HB_CellEdge(float2 p, int count, uint seed)
{
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float best = 1e9;
    float2 closest = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        float2 toward = cell - base + HB_Random2(HB_WrapCell(cell, count), seed) - f;
        float distance = dot(toward, toward);

        if (distance < best)
        {
            best = distance;
            closest = toward;
        }
    }

    float edge = 1e9;

    [unroll]
    for (int k = 0; k < 9; k++)
    {
        int2 cell = base + int2(k % 3 - 1, k / 3 - 1);
        float2 toward = cell - base + HB_Random2(HB_WrapCell(cell, count), seed) - f;
        float2 split = toward - closest;

        if (dot(split, split) > 1e-6)
            edge = min(edge, dot((closest + toward) * 0.5, normalize(split)));
    }

    return edge;
}

float HB_HairCracks(float2 uv)
{
    if (HB_HAIR <= 0.0)
        return 0.0;

    int count = max(HB_UNITS * HB_HAIR_SCALE, 1);
    uint seed = HB_SEED + 700u;
    float2 jag = float2(HB_PerlinFbm(uv, count * 4, seed + 1u), HB_PerlinFbm(uv, count * 4, seed + 2u)) - 0.5;
    float edge = HB_CellEdge(uv * count + jag * 0.45, count, seed);
    float reach = HB_PerlinFbm(uv, max((int)((uint)count / 2u), 1), seed + 3u);
    float start = lerp(0.72, 0.3, HB_HAIR);
    float open = smoothstep(start, start + 0.15, reach);
    float width = max(count * _Size.y, (0.01 + 0.015 * open) * HB_HAIR_SCALE);

    return saturate(open * 2.0) * (1.0 - smoothstep(width * 0.4, width, edge));
}

float HB_Chip(float2 uv, float4 cell)
{
    if (HB_CHIPS <= 0.0 || cell.x <= 0.0)
        return 0.0;

    int count = max(HB_UNITS * 3, 1);
    uint seed = HB_SEED + 720u;
    float2 p = uv * count;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float pixel = count * _Size.y;
    float chip = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 near = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(near, count);

        if (HB_Random(wrapped, seed) >= HB_CHIPS)
            continue;

        float2 spot = HB_Random2(wrapped, seed + 1u);
        int2 texel = (int2)((float2(wrapped) + spot) / count * HB_SIZE);
        float4 at = _CellsIn[HB_Wrap(texel)];

        if (abs(at.y - cell.y) > 1e-6 || at.x <= 0.0 || at.x > HB_CHIP_SIZE * 0.7)
            continue;

        float2 toward = f - (near - base + spot);
        float wobble = 1.0 + 0.25 * sin(atan2(toward.y, toward.x) * 3.0 + HB_Random(wrapped, seed + 3u) * TAU);
        float radius = HB_CHIP_SIZE * count * (0.6 + 0.5 * HB_Random(wrapped, seed + 2u)) * wobble;

        chip = max(chip, saturate((radius - length(toward)) / pixel));
    }

    return chip;
}

float HB_Scratches(float2 uv)
{
    if (HB_SCRATCHES <= 0.0)
        return 0.0;

    int count = max(HB_SCRATCH_SCALE, 1);
    uint seed = HB_SEED + 740u;
    float2 p = uv * count;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float pixel = count * _Size.y;
    float mark = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(cell, count);

        if (HB_Random(wrapped, seed) >= HB_SCRATCHES)
            continue;

        float2 centre = cell - base + HB_Random2(wrapped, seed + 1u);
        float angle = HB_Random(wrapped, seed + 2u) * PI;
        float reach = 0.25 + 0.6 * HB_Random(wrapped, seed + 3u);
        float2 direction = float2(cos(angle), sin(angle));
        float2 toward = f - centre;
        float along = clamp(dot(toward, direction), -reach, reach);
        float fade = 1.0 - abs(along) / reach;
        float width = max(pixel, (0.0015 + 0.0015 * fade) * count);
        float stroke = 1.0 - smoothstep(width * 0.5, width, length(toward - direction * along));

        mark = max(mark, stroke * saturate(fade * 3.0) * (0.4 + 0.6 * HB_Random(wrapped, seed + 4u)));
    }

    return mark;
}

float HB_JointPebbles(float2 uv, float edge)
{
    if (HB_JOINT_PEBBLES <= 0.0 || edge > 0.0)
        return 0.0;

    int count = max(HB_UNITS * 10, 1);
    uint seed = HB_SEED + 760u;
    float2 p = uv * count;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float top = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(cell, count);

        if (HB_Random(wrapped, seed) >= HB_JOINT_PEBBLES)
            continue;

        float2 centre = cell - base + HB_Random2(wrapped, seed + 1u);
        float radius = 0.25 + 0.3 * HB_Random(wrapped, seed + 2u);
        float reach = length(f - centre) / radius;

        if (reach < 1.0)
            top = max(top, sqrt(1.0 - reach * reach) * (0.6 + 0.4 * HB_Random(wrapped, seed + 3u)));
    }

    return top * 0.18;
}

float HB_JointGrass(float2 uv)
{
    if (HB_JOINT_GRASS <= 0.0)
        return 0.0;

    int count = max(HB_UNITS * 4, 1);
    uint seed = HB_SEED + 780u;
    float2 p = uv * count;
    int2 base = (int2)floor(p);
    float2 f = p - base;
    float grass = 0.0;

    [unroll]
    for (int j = 0; j < 9; j++)
    {
        int2 cell = base + int2(j % 3 - 1, j / 3 - 1);
        uint2 wrapped = HB_WrapCell(cell, count);

        if (HB_Random(wrapped, seed) >= HB_JOINT_GRASS)
            continue;

        float2 spot = HB_Random2(wrapped, seed + 1u);
        int2 root = (int2)((float2(wrapped) + spot) / count * HB_SIZE);

        if (_CellsIn[HB_Wrap(root)].x > 0.0)
            continue;

        float2 toward = f - (cell - base + spot);
        float reach = length(toward) / (0.35 + 0.35 * HB_Random(wrapped, seed + 2u));

        if (reach >= 1.0)
            continue;

        float blades = 7.0 + floor(HB_Random(wrapped, seed + 3u) * 6.0);
        float twist = HB_Random(wrapped, seed + 4u) * TAU + reach * 1.5;
        float blade = pow(abs(cos((atan2(toward.y, toward.x) + twist) * blades * 0.5)), 6.0 + reach * 20.0);

        grass = max(grass, saturate(blade * 1.5) * (1.0 - reach) * (0.5 + 0.3 * HB_Random(wrapped, seed + 5u)));
    }

    return grass;
}

float HB_StoneHeight(float2 uv, float4 cell, float floorHeight)
{
    int units = HB_UNITS;
    float edge = cell.x;
    float2 shape = cell.zw;
    uint key = HB_StoneKey(cell.y);
    float pixel = units * _Size.y;

    float rim = sin(saturate(edge / max(HB_BEVEL, pixel)) * PI * 0.5);
    float dome = 1.0 - saturate(dot(shape, shape));
    float facet = 1.0;
    float turn = HB_StoneRandom(key, 1u) * TAU;

    [unroll]
    for (int i = 0; i < FACETS; i++)
    {
        float angle = turn + i * (TAU / FACETS) + (HB_StoneRandom(key, 10u + i) - 0.5) * 0.6;
        float steep = 0.6 + 0.6 * HB_StoneRandom(key, 20u + i);

        facet = min(facet, 1.0 - steep * dot(shape, float2(cos(angle), sin(angle))));
    }

    float surface = lerp(dome, saturate(facet), HB_FACETS);
    float curve = HB_DOME < 0.0 ? HB_DOME : max(HB_DOME, HB_FACETS);
    float top = lerp(1.0, surface, curve) / (1.0 - min(curve, 0.0));
    float rise = 1.0 - HB_RISE_SPREAD * HB_StoneRandom(key, 2u);
    float lean = HB_StoneRandom(key, 3u) * TAU;
    float tilt = HB_TILT * 0.35 * dot(shape, float2(cos(lean), sin(lean)));
    float grain = (HB_Fbm(uv, units * 8, HB_SEED + 51u) - 0.5) * HB_ROUGHNESS * 0.3;

    if (HB_WOOD)
    {
        float rings, fibres, knot;
        uint2 texel = (uint2)(uv * HB_SIZE);

        HB_WoodGrain(_FrameIn[texel], key, rings, fibres, knot);
        grain += HB_WOOD_RELIEF * (knot * 0.05 - (rings * HB_RINGS * 0.6 + fibres * HB_FIBRES * 0.4) * 0.15);
    }

    float height = max(rim * saturate(rise * top + tilt + grain), floorHeight);
    float chip = HB_Chip(uv, cell);
    float broken = lerp(floorHeight, height, 0.3 + 0.25 * HB_PerlinFbm(uv, units * 16, HB_SEED + 722u));

    height = lerp(height, min(broken, height), chip);
    height -= HB_HairCracks(uv) * 0.3 + HB_Scratches(uv) * 0.06;

    return max(height, floorHeight);
}

[numthreads(8, 8, 1)]
void Shape(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    float4 cell = _CellsIn[id.xy];
    float floorHeight = HB_Ground(uv);
    float height = floorHeight;

    if (cell.x > 0.0)
        height = HB_StoneHeight(uv, cell, floorHeight);

    float fill = max(HB_JointPebbles(uv, cell.x), HB_JointGrass(uv));

    _Height[id.xy] = max(height, floorHeight + fill);
}

float HB_Ring(int2 texel, float radius)
{
    float sum = 0.0;

    [unroll]
    for (int tap = 0; tap < AO_TAPS; tap++)
    {
        float angle = tap * (TAU / AO_TAPS);
        int2 offset = (int2)round(float2(cos(angle), sin(angle)) * radius);

        sum += HB_HeightAt(texel + offset);
    }

    return sum / AO_TAPS;
}

[numthreads(8, 8, 1)]
void Derive(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    int2 texel = (int2)id.xy;
    float size = _Size.x;
    float scale = size / 256.0;
    float height = HB_HeightAt(texel);

    float left = HB_HeightAt(texel + int2(-1, 0));
    float right = HB_HeightAt(texel + int2(1, 0));
    float down = HB_HeightAt(texel + int2(0, -1));
    float up = HB_HeightAt(texel + int2(0, 1));

    float slope = HB_DEPTH * size * 0.5;
    float3 normal = normalize(float3((left - right) * slope, (down - up) * slope, 1.0));

    float reach = max(HB_LIGHT_WIDTH * scale, 1.0);
    float around = HB_Ring(texel, reach);
    float curve = (around - height) * HB_DEPTH * size / reach * CURVE_GAIN;
    float edge = saturate(-curve);
    float cavity = saturate(curve);

    float occlusion = 0.0;
    float radius = 2.0 * scale;

    [unroll]
    for (int ring = 0; ring < AO_RINGS; ring++)
    {
        occlusion += saturate((HB_Ring(texel, radius) - height) * HB_DEPTH * size / radius);
        radius *= 2.0;
    }

    float ao = saturate(1.0 - occlusion / AO_RINGS * AO_GAIN);

    _Detail[id.xy] = float4(edge, cavity, ao, 0.0);
    _NormalPreview[id.xy] = float4(1.0, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, normal.x * 0.5 + 0.5);
    _NormalExport[id.xy] = float4(normal * 0.5 + 0.5, 1.0);
}

[numthreads(8, 8, 1)]
void Compose(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float2 uv = HB_Uv(id.xy);
    int units = HB_UNITS;
    float4 cell = _CellsIn[id.xy];
    float4 detail = _DetailIn[id.xy];
    float height = _HeightIn[id.xy];
    uint key = HB_StoneKey(cell.y);
    float pixel = units * _Size.y;
    float stone = saturate(cell.x / pixel + 0.5);

    float grain = (HB_Fbm(uv, units * 16, HB_SEED + 61u) - 0.5) * _StoneColour.w * 2.0;
    float3 rock = _StoneColour.rgb * (1.0 + grain);
    float3 ground = _GapColour.rgb * (1.0 + grain * 0.5);

    if (_VariationMore.y > 0.0)
    {
        float tone = 1.0 + _VariationColour.w * (HB_StoneRandom(key, 4u) - 0.5) * 2.0;
        float other = HB_StoneRandom(key, 5u) < _VariationMore.x ? 0.5 + 0.5 * HB_StoneRandom(key, 6u) : 0.0;

        rock = lerp(rock, _VariationColour.rgb * (1.0 + grain), other) * tone;

        if (HB_ORGANIC)
            ground *= 1.0 + (HB_Organic(uv, 3, HB_SEED + 95u) - 0.5) * _VariationColour.w * 2.0;
    }

    if (HB_WOOD && _Wood.x + _Wood.z + _Wood.w > 0.0)
    {
        float rings, fibres, knot;

        HB_WoodGrain(_FrameIn[id.xy], key, rings, fibres, knot);

        float streak = saturate(rings * HB_RINGS + (fibres - 0.3) * HB_FIBRES * 0.8);

        rock = lerp(rock, _GrainColour.rgb, streak);
        rock = lerp(rock, _GrainColour.rgb * 0.6, knot);
    }

    rock = lerp(rock, _WearColour.rgb, saturate(detail.x * 3.0) * _WearColour.w);

    float hair = HB_HairCracks(uv);
    float chip = HB_Chip(uv, cell);
    float scratch = HB_Scratches(uv);

    rock = lerp(rock, _WearColour.rgb, saturate(chip * 0.6 + scratch * 0.7));
    rock = lerp(rock, _GapColour.rgb * 0.5, hair * 0.8);

    if (_VariationMore.y > 0.0)
    {
        float lift = 1.0 + _VariationMore.z * (height - 0.5);

        rock *= lift;
        ground *= lerp(1.0, lift, 0.5);
    }

    float near = 1.0 - saturate(cell.x / max(_DirtMore.x * 0.5, pixel));
    float dirtNoise = HB_Fbm(uv, units * 4, HB_SEED + 71u);
    float dirt = saturate(max(near, detail.y * 2.0) * (0.4 + 1.2 * dirtNoise)) * _DirtColour.w * stone;

    float low = 1.0 - saturate(height / max(_MossMore.x, 0.01));
    float mossNoise = HB_Fbm(uv, (int)_MossMore.y, HB_SEED + 81u);
    float moss = smoothstep(0.0, 0.3, low * (0.3 + mossNoise) - (1.0 - _MossColour.w)) * step(1e-3, _MossColour.w);

    float3 colour = lerp(ground, rock, stone);

    float pebble = HB_JointPebbles(uv, cell.x);
    float tuft = HB_JointGrass(uv);
    float fill = max(pebble, tuft);
    float filled = step(0.005, fill) * saturate((HB_Ground(uv) + fill - height) * 400.0 + 1.0);
    float grassy = filled * step(pebble, tuft);

    colour = lerp(colour, lerp(_GapColour.rgb, _StoneColour.rgb, 0.6) * (0.75 + pebble * 2.0), filled - grassy);
    colour = lerp(colour, _DirtColour.rgb, dirt);
    colour = lerp(colour, _MossColour.rgb * (1.0 + grain * 0.5), moss);

    float specks = _Specks.w > 0.0 ? HB_Specks(uv, HB_SEED + 91u) : 0.0;

    colour = lerp(colour, _Specks.rgb, specks);
    colour = lerp(colour, _GrassColour.rgb * (0.55 + tuft * 0.9), grassy);

    float light = 1.0 + detail.x * HB_EDGE_LIGHT - detail.y * HB_CAVITY_DARK;
    float3 albedo = saturate(colour * light * lerp(1.0, detail.z, HB_AO_BAKE));
    float smoothness = lerp(HB_GAP_SMOOTH, HB_SMOOTHNESS, stone);

    smoothness = lerp(smoothness, HB_ROUGH_SMOOTH, max(dirt, moss));
    smoothness = lerp(smoothness, _SpecksMore.y, specks * _SpecksMore.z);
    smoothness = lerp(smoothness, HB_ROUGH_SMOOTH, grassy);

    _Albedo[id.xy] = float4(albedo, 1.0);
    _Mask[id.xy] = float4(HB_METALLIC * stone * (1.0 - moss) * (1.0 - filled), detail.z, height, smoothness);
}

float3 HB_ToDisplay(float3 value)
{
    return pow(saturate(value), 2.2);
}

[numthreads(8, 8, 1)]
void Show(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    float4 detail = _DetailIn[id.xy];
    float3 colour;

    if (_ShowMode == 0)
        colour = _AlbedoIn[id.xy].rgb;
    else if (_ShowMode == 1)
        colour = HB_ToDisplay(_NormalIn[id.xy].rgb);
    else if (_ShowMode == 2)
        colour = HB_ToDisplay(_MaskIn[id.xy].rgb);
    else if (_ShowMode == 3)
        colour = HB_ToDisplay(_HeightIn[id.xy].xxx);
    else if (_ShowMode == 4)
        colour = HB_ToDisplay(detail.zzz);
    else
        colour = HB_ToDisplay(0.5 + (detail.x - detail.y) * 0.5).xxx;

    _Display[id.xy] = float4(colour, 1.0);
}

float3 HB_LinearToSrgb(float3 value)
{
    value = saturate(value);

    return value <= 0.0031308 ? value * 12.92 : 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

[numthreads(8, 8, 1)]
void Encode(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_SIZE))
        return;

    _Encoded[id.xy] = float4(HB_LinearToSrgb(_AlbedoIn[id.xy].rgb), 1.0);
}
