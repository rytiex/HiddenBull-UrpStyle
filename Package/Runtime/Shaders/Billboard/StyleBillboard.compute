#pragma kernel Cull

struct HB_BillboardInstance
{
    float4 row0;
    float4 row1;
    float4 row2;
    float4 inverse0;
    float4 inverse1;
    float4 inverse2;
    float4 sphere;
};

StructuredBuffer<HB_BillboardInstance> _HB_BillboardInstances;
AppendStructuredBuffer<uint2> _HB_BillboardNear;
AppendStructuredBuffer<uint2> _HB_BillboardFar;

float4 _HB_BillboardPlanes[6];
float4 _HB_BillboardEye;
float4 _HB_BillboardRanges;
float4 _HB_BillboardSun;
float4 _HB_BillboardView;

#define HB_BILLBOARD_SHADOW_REACH 2.0
#define HB_BILLBOARD_LOW_SUN 0.25

bool HB_BillboardSeen(float4 sphere, float distance)
{
    float reach = distance < _HB_BillboardSun.w + sphere.w
        ? sphere.w * HB_BILLBOARD_SHADOW_REACH / max(-_HB_BillboardSun.y, HB_BILLBOARD_LOW_SUN)
        : 0.0;

    float3 tail = sphere.xyz + _HB_BillboardSun.xyz * reach;

    [unroll]
    for (int side = 0; side < 6; side++)
    {
        float4 plane = _HB_BillboardPlanes[side];
        float head = dot(plane.xyz, sphere.xyz) + plane.w;
        float shadow = dot(plane.xyz, tail) + plane.w;

        if (max(head, shadow) < -sphere.w)
            return false;
    }

    return true;
}

[numthreads(64, 1, 1)]
void Cull(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;

    if (index >= (uint)_HB_BillboardEye.w)
        return;

    float4 sphere = _HB_BillboardInstances[index].sphere;
    float distance = length(sphere.xyz - _HB_BillboardEye.xyz);
    float seen = distance * _HB_BillboardView.x;

    if (seen >= _HB_BillboardRanges.y || !HB_BillboardSeen(sphere, distance))
        return;

    float mesh = saturate((_HB_BillboardRanges.x - seen) * _HB_BillboardRanges.z);

    if (mesh > 0.0)
        _HB_BillboardNear.Append(uint2(index, asuint(mesh)));

    if (mesh >= 1.0)
        return;

    float fade = mesh > 0.0 ? -mesh : saturate((_HB_BillboardRanges.y - seen) * _HB_BillboardRanges.w);

    if (fade != 0.0)
        _HB_BillboardFar.Append(uint2(index, asuint(fade)));
}
