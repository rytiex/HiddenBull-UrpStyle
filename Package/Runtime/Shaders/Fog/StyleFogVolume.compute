#pragma kernel Integrate

#define HB_FOG_TILES 8

Texture2D<float4> _HB_FogInject;
RWTexture3D<float4> _HB_FogIntegrated;

float4 _HB_FogVolumeSize;
float4 _HB_FogVolumeParams;

float HB_SliceDepth(float slice)
{
    return exp(_HB_FogVolumeParams.x + slice / (_HB_FogVolumeSize.z * _HB_FogVolumeParams.y));
}

[numthreads(8, 8, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint2 size = uint2(_HB_FogVolumeSize.xy);

    if (any(id.xy >= size))
        return;

    uint slices = (uint)_HB_FogVolumeSize.z;

    float transmittance = 1.0;
    float sun = 0.0;
    float sky = 0.0;
    float nearDepth = HB_SliceDepth(0.0);

    for (uint slice = 0; slice < slices; slice++)
    {
        uint2 tile = uint2(slice % HB_FOG_TILES, slice / HB_FOG_TILES);
        float4 froxel = _HB_FogInject[tile * size + id.xy];

        float farDepth = HB_SliceDepth(slice + 1.0);
        float passed = exp(-froxel.r * (farDepth - nearDepth));

        nearDepth = farDepth;
        float scattered = transmittance * (1.0 - passed);

        sun += scattered * froxel.g;
        sky += scattered * froxel.b;
        transmittance *= passed;

        _HB_FogIntegrated[uint3(id.xy, slice)] = float4(sun, sky, 1.0 - transmittance, 0.0);
    }
}
