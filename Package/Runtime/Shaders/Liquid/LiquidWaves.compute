#pragma kernel Bake

#define HB_WAVE_BANDS 3
#define HB_WAVE_COUNT 12

RWTexture2DArray<float4> _HB_WaveDisplacementOut;
RWTexture2DArray<float4> _HB_WaveDerivativeOut;

float4 _HB_WaveSet[HB_WAVE_BANDS * HB_WAVE_COUNT];
float4 _HB_WavePatch;
float4 _HB_WaveBake;

#define HB_WAVE_RESOLUTION _HB_WaveBake.x
#define HB_WAVE_CHOP       _HB_WaveBake.y

[numthreads(8, 8, 1)]
void Bake(uint3 id : SV_DispatchThreadID)
{
    if (any((float2)id.xy >= HB_WAVE_RESOLUTION) || id.z >= HB_WAVE_BANDS)
        return;

    float2 position = ((float2)id.xy + 0.5) / HB_WAVE_RESOLUTION * _HB_WavePatch[id.z];

    float3 offset = float3(0.0, 0.0, 0.0);
    float2 slope = float2(0.0, 0.0);
    float3 fold = float3(0.0, 0.0, 0.0);

    for (uint index = 0; index < HB_WAVE_COUNT; index++)
    {
        float4 wave = _HB_WaveSet[id.z * HB_WAVE_COUNT + index];
        float number = max(length(wave.xy), 1e-5);
        float2 direction = wave.xy / number;

        float s, c;
        sincos(dot(wave.xy, position) + wave.w, s, c);

        float push = wave.z * HB_WAVE_CHOP;

        offset.y += wave.z * s;
        offset.xz += direction * (push * c);
        slope += wave.xy * (wave.z * c);
        fold -= float3(direction.x * direction.x, direction.y * direction.y, direction.x * direction.y)
              * (number * push * s);
    }

    _HB_WaveDisplacementOut[id] = float4(offset, fold.z);
    _HB_WaveDerivativeOut[id] = float4(slope, fold.xy);
}

#pragma kernel CalmSeed
#pragma kernel CalmSpread
#pragma kernel CalmFinish
#pragma kernel CalmTiles

Texture2D<float> _HB_CalmHeightmap;
Texture2D<float2> _HB_CalmLevel;
Texture2D<float> _HB_CalmHoles;
Texture2D<float4> _HB_CalmFlow;
Texture2D<float4> _HB_CalmIn;
RWTexture2D<float4> _HB_CalmOut;
RWTexture2D<float2> _HB_CalmTilesOut;
SamplerState sampler_LinearClamp;
SamplerState sampler_PointClamp;

float4 _HB_CalmGrid;
float4 _HB_CalmTerrain;
float4 _HB_CalmTile;

#define HB_CALM_SIZE       ((uint)_HB_CalmGrid.x)
#define HB_CALM_CELL       _HB_CalmGrid.y
#define HB_CALM_SLOPE      _HB_CalmGrid.z
#define HB_CALM_STEP       ((int)_HB_CalmGrid.w)
#define HB_CALM_GROUND     _HB_CalmTerrain.x
#define HB_CALM_SEA        _HB_CalmTerrain.y
#define HB_CALM_RANGE      _HB_CalmTerrain.z
#define HB_CALM_RESOLUTION _HB_CalmTerrain.w
#define HB_CALM_TILES      ((uint)_HB_CalmTile.x)
#define HB_CALM_TILE       _HB_CalmTile.y
#define HB_CALM_EXTENT     _HB_CalmTile.zw
#define HB_CALM_CUT        0.5
#define HB_CALM_STREAM     0.01
#define HB_CALM_SURE       0.25
#define HB_CALM_OPEN       1e4
#define HB_CALM_HOLE       0.5

[numthreads(8, 8, 1)]
void CalmSeed(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= HB_CALM_SIZE))
        return;

    float2 uv = ((float2)id.xy + 0.5) / HB_CALM_SIZE;
    float2 texel = (uv * (HB_CALM_RESOLUTION - 1.0) + 0.5) / HB_CALM_RESOLUTION;
    float ground = _HB_CalmHeightmap.SampleLevel(sampler_LinearClamp, texel, 0) * HB_CALM_GROUND;

    uint width, height;
    _HB_CalmLevel.GetDimensions(width, height);

    float raised = _HB_CalmLevel.SampleLevel(sampler_LinearClamp, uv, 0).r;
    float cut = _HB_CalmLevel.Load(int3(min(uint2(uv * float2(width, height)), uint2(width, height) - 1), 0)).g;
    float level = HB_CALM_SEA + (raised * 65535.0 - 32768.0) / 32767.0 * HB_CALM_RANGE;
    float depth = cut >= HB_CALM_CUT ? 0.0 : max(level - ground, 0.0);
    bool holed = _HB_CalmHoles.SampleLevel(sampler_PointClamp, uv, 0) < HB_CALM_HOLE;

    _HB_CalmOut[id.xy] = holed ? float4(HB_CALM_OPEN, 1.0, 0.0, 0.0) : float4(depth, 0.0, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void CalmSpread(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= HB_CALM_SIZE))
        return;

    float4 here = _HB_CalmIn[id.xy];

    if (here.g > HB_CALM_HOLE)
    {
        _HB_CalmOut[id.xy] = here;
        return;
    }

    float depth = here.r;
    int step = HB_CALM_STEP;

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 at = (int2)id.xy + int2(x, y) * step;

            if ((x == 0 && y == 0) || any(at < 0) || any(at >= (int)HB_CALM_SIZE))
                continue;

            float reach = length(float2(x, y)) * step * HB_CALM_CELL * HB_CALM_SLOPE;

            depth = min(depth, _HB_CalmIn[at].r + reach);
        }
    }

    _HB_CalmOut[id.xy] = float4(depth, 0.0, 0.0, 0.0);
}

float HB_CalmSolid(int2 at, float fallback)
{
    float4 calm = _HB_CalmIn[at];

    return calm.g > HB_CALM_HOLE ? fallback : calm.r;
}

[numthreads(8, 8, 1)]
void CalmFinish(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= HB_CALM_SIZE))
        return;

    int last = (int)HB_CALM_SIZE - 1;
    int2 at = (int2)id.xy;
    float4 here = _HB_CalmIn[at];

    if (here.g > HB_CALM_HOLE)
    {
        _HB_CalmOut[id.xy] = float4(here.r, 0.0, 0.0, 0.0);
        return;
    }

    float left = HB_CalmSolid(int2(max(at.x - 1, 0), at.y), here.r);
    float right = HB_CalmSolid(int2(min(at.x + 1, last), at.y), here.r);
    float down = HB_CalmSolid(int2(at.x, max(at.y - 1, 0)), here.r);
    float up = HB_CalmSolid(int2(at.x, min(at.y + 1, last)), here.r);
    float2 slope = float2(right - left, up - down) / (2.0 * HB_CALM_CELL);
    float steep = length(slope);
    float2 toward = steep > 1e-5 ? -slope / steep : float2(0.0, 0.0);

    _HB_CalmOut[id.xy] = float4(here.r, toward, saturate(steep / HB_CALM_SLOPE));
}

[numthreads(8, 8, 1)]
void CalmTiles(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= HB_CALM_TILES))
        return;

    float2 uv = ((float2)id.xy + 0.5) * HB_CALM_TILE / HB_CALM_EXTENT;
    float2 stream = _HB_CalmFlow.SampleLevel(sampler_LinearClamp, uv, 0).xy;
    float4 calm = _HB_CalmIn.SampleLevel(sampler_LinearClamp, uv, 0);
    float rush = dot(stream, stream);
    float2 heading = float2(0.0, 0.0);

    if (rush > HB_CALM_STREAM * HB_CALM_STREAM)
        heading = stream * rsqrt(rush);
    else if (calm.w > HB_CALM_SURE && dot(calm.yz, calm.yz) > HB_CALM_SURE)
        heading = normalize(calm.yz);

    _HB_CalmTilesOut[id.xy] = heading;
}

#pragma kernel Foam

RWTexture2D<float> _HB_FoamOut;

float4 _HB_FoamBake;

#define HB_FOAM_COARSE 12.0
#define HB_FOAM_FINE   29.0
#define HB_FOAM_GAIN   1.6
#define HB_FOAM_SHARE  0.65

float2 HB_FoamSite(float2 cell, float period)
{
    float2 wrapped = cell - floor(cell / period) * period;
    float3 p = frac(float3(wrapped.xyx) * float3(0.1031, 0.1030, 0.0973));

    p += dot(p, p.yzx + 33.33);

    return frac((p.xx + p.yz) * p.zy);
}

float HB_FoamWalls(float2 position, float period)
{
    float2 corner = floor(position);
    float nearest = 8.0;
    float next = 8.0;

    for (int z = -1; z <= 1; z++)
    {
        for (int x = -1; x <= 1; x++)
        {
            float2 cell = corner + float2(x, z);
            float span = length(position - cell - HB_FoamSite(cell, period));

            next = span < nearest ? nearest : min(next, span);
            nearest = min(nearest, span);
        }
    }

    return saturate((next - nearest) * HB_FOAM_GAIN);
}

[numthreads(8, 8, 1)]
void Foam(uint3 id : SV_DispatchThreadID)
{
    if (any((float2)id.xy >= _HB_FoamBake.x))
        return;

    float2 uv = ((float2)id.xy + 0.5) / _HB_FoamBake.x;

    _HB_FoamOut[id.xy] = lerp(HB_FoamWalls(uv * HB_FOAM_FINE + 0.37, HB_FOAM_FINE),
                              HB_FoamWalls(uv * HB_FOAM_COARSE, HB_FOAM_COARSE), HB_FOAM_SHARE);
}

#pragma kernel Caustics

#define HB_CAUSTIC_COUNT 16

RWTexture2D<float4> _HB_CausticsOut;

float4 _HB_CausticSet[HB_CAUSTIC_COUNT];
float4 _HB_CausticBake;

[numthreads(8, 8, 1)]
void Caustics(uint3 id : SV_DispatchThreadID)
{
    if (any((float2)id.xy >= _HB_CausticBake.x))
        return;

    float2 position = ((float2)id.xy + 0.5) / _HB_CausticBake.x * _HB_CausticBake.y;
    float3 bent = float3(0.0, 0.0, 0.0);

    for (uint index = 0; index < HB_CAUSTIC_COUNT; index++)
    {
        float4 wave = _HB_CausticSet[index];
        float2 direction = wave.xy / max(length(wave.xy), 1e-5);

        bent -= float3(direction.x * direction.x, direction.y * direction.y, direction.x * direction.y)
              * (wave.z * sin(dot(wave.xy, position) + wave.w));
    }

    _HB_CausticsOut[id.xy] = float4(bent, 0.0);
}

#pragma kernel PlateMask
#pragma kernel PlateSpread
#pragma kernel PlateFill
#pragma kernel PlateTone

Texture2D<float4> _HB_PlateNormal;
RWStructuredBuffer<uint> _HB_PlateLabels;
RWStructuredBuffer<float> _HB_PlateShape;
RWTexture2D<float4> _HB_PlateOut;
SamplerState sampler_LinearRepeat;

float4 _HB_PlateBake;

#define HB_PLATE_SIZE  ((int)_HB_PlateBake.x)
#define HB_PLATE_LOD   _HB_PlateBake.y
#define HB_PLATE_FLAT  0.4
#define HB_PLATE_CRACK 0.7
#define HB_PLATE_REACH 2
#define HB_PLATE_SOLID 0.5
#define HB_PLATE_NEAR  5
#define HB_PLATE_STEP  2
#define HB_PLATE_HEAT_FROM   0.1
#define HB_PLATE_HEAT_TO     0.55
#define HB_PLATE_HEAT_BASE   0.8
#define HB_PLATE_HEAT_STREAK 0.45

static const int2 s_PlateAround[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };

uint HB_PlateIndex(int2 at)
{
    uint2 wrapped = (uint2)(at + HB_PLATE_SIZE) % (uint)HB_PLATE_SIZE;

    return (uint)(wrapped.y * HB_PLATE_SIZE + wrapped.x);
}

float HB_PlateSlope(int2 at)
{
    float2 uv = ((float2)at + 0.5) / HB_PLATE_SIZE;
    float4 packed = _HB_PlateNormal.SampleLevel(sampler_LinearRepeat, uv, HB_PLATE_LOD);

    packed.a *= packed.r;
    return length(packed.ag * 2.0 - 1.0);
}

float HB_PlateHash(uint value)
{
    value ^= 2747636419u;
    value *= 2654435769u;
    value ^= value >> 16;
    value *= 2654435769u;
    value ^= value >> 16;
    value *= 2654435769u;

    return (float)value / 4294967295.0;
}

float HB_PlateNoise(float2 at, uint period, uint salt)
{
    float2 cell = floor(at);
    float2 fade = at - cell;
    uint2 low = (uint2)(cell - period * floor(cell / period));
    uint2 high = (low + 1u) % period;

    fade = fade * fade * (3.0 - 2.0 * fade);

    float a = HB_PlateHash(low.x + low.y * 4099u + salt);
    float b = HB_PlateHash(high.x + low.y * 4099u + salt);
    float c = HB_PlateHash(low.x + high.y * 4099u + salt);
    float d = HB_PlateHash(high.x + high.y * 4099u + salt);

    return lerp(lerp(a, b, fade.x), lerp(c, d, fade.x), fade.y);
}

float HB_PlateStreak(uint2 at)
{
    float2 uv = ((float2)at + 0.5) / HB_PLATE_SIZE;
    float2 warp = float2(HB_PlateNoise(uv * 4.0, 4u, 11u), HB_PlateNoise(uv * 4.0, 4u, 23u)) - 0.5;
    float flow = HB_PlateNoise(uv * 6.0 + warp * 2.5, 6u, 37u) * 0.65
               + HB_PlateNoise(uv * 12.0 + warp * 5.0, 12u, 41u) * 0.35;
    float band = 1.0 - abs(frac(flow * 5.0) * 2.0 - 1.0);

    return band * band * band;
}

[numthreads(8, 8, 1)]
void PlateMask(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_PLATE_SIZE))
        return;

    float steep = 0.0;

    for (int y = -HB_PLATE_REACH; y <= HB_PLATE_REACH; y++)
    {
        for (int x = -HB_PLATE_REACH; x <= HB_PLATE_REACH; x++)
            steep = max(steep, HB_PlateSlope((int2)id.xy + int2(x, y)));
    }

    float shape = 1.0 - smoothstep(HB_PLATE_FLAT, HB_PLATE_CRACK, steep);
    uint index = HB_PlateIndex((int2)id.xy);

    _HB_PlateShape[index] = shape;
    _HB_PlateLabels[index] = shape > HB_PLATE_SOLID ? index + 1 : 0;
}

[numthreads(8, 8, 1)]
void PlateSpread(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_PLATE_SIZE))
        return;

    uint index = HB_PlateIndex((int2)id.xy);
    uint label = _HB_PlateLabels[index];

    if (label == 0)
        return;

    for (int side = 0; side < 4; side++)
    {
        uint other = _HB_PlateLabels[HB_PlateIndex((int2)id.xy + s_PlateAround[side])];

        if (other != 0)
            label = min(label, other);
    }

    _HB_PlateLabels[index] = label;
}

[numthreads(8, 8, 1)]
void PlateFill(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_PLATE_SIZE))
        return;

    uint index = HB_PlateIndex((int2)id.xy);
    uint label = _HB_PlateLabels[index];

    if (label != 0)
        return;

    for (int side = 0; side < 4; side++)
        label = max(label, _HB_PlateLabels[HB_PlateIndex((int2)id.xy + s_PlateAround[side])]);

    _HB_PlateLabels[index] = label;
}

[numthreads(8, 8, 1)]
void PlateTone(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= HB_PLATE_SIZE))
        return;

    uint index = HB_PlateIndex((int2)id.xy);
    uint label = _HB_PlateLabels[index];

    float near = 0.0;
    float total = 0.0;

    for (int y = -HB_PLATE_NEAR; y <= HB_PLATE_NEAR; y++)
    {
        for (int x = -HB_PLATE_NEAR; x <= HB_PLATE_NEAR; x++)
        {
            float weight = exp(-(float)(x * x + y * y) / (float)(HB_PLATE_NEAR * HB_PLATE_NEAR));

            near += _HB_PlateShape[HB_PlateIndex((int2)id.xy + int2(x, y) * HB_PLATE_STEP)] * weight;
            total += weight;
        }
    }

    near /= total;

    float heat = saturate((near - HB_PLATE_HEAT_FROM) / (HB_PLATE_HEAT_TO - HB_PLATE_HEAT_FROM));

    heat = saturate(heat * HB_PLATE_HEAT_BASE + HB_PlateStreak(id.xy) * HB_PLATE_HEAT_STREAK);
    _HB_PlateOut[id.xy] = float4(_HB_PlateShape[index], label != 0 ? HB_PlateHash(label) : 0.5, near, heat);
}

#pragma kernel Wake

Texture2D<float4> _HB_WakeState;
RWTexture2D<float4> _HB_WakeStateOut;
RWTexture2D<float4> _HB_WakeLookOut;
StructuredBuffer<float4> _HB_WakeStamps;

float4 _HB_WakeFrame;
float4 _HB_WakeFrom;

#define HB_WAKE_SIZE    256
#define HB_WAKE_SPAN    64.0
#define HB_WAKE_SPEED   2.0
#define HB_WAKE_DAMP    0.6
#define HB_WAKE_SETTLE  0.15
#define HB_WAKE_SMOOTH  0.5
#define HB_WAKE_FASTEST 4.0
#define HB_WAKE_PUSH    1.5
#define HB_WAKE_TILT    1.0
#define HB_WAKE_STAMP   2
#define HB_WAKE_LIMIT   32

float HB_WakeHeight(int2 texel)
{
    return _HB_WakeState.Load(int3(texel & (HB_WAKE_SIZE - 1), 0)).r;
}

float HB_WakeApart(float2 xz, float2 from, float2 to)
{
    float2 span = to - from;
    float along = saturate(dot(xz - from, span) / max(dot(span, span), 1e-6));

    return distance(xz, from + span * along);
}

[numthreads(8, 8, 1)]
void Wake(uint3 id : SV_DispatchThreadID)
{
    float texel = HB_WAKE_SPAN / HB_WAKE_SIZE;
    float step = _HB_WakeFrame.z;
    int half_size = HB_WAKE_SIZE / 2;
    int2 here = (int2)id.xy;
    int2 anchor = (int2)floor(_HB_WakeFrame.xy / texel);
    int2 earlier = (int2)floor(_HB_WakeFrom.xy / texel);
    int2 spot = anchor + ((here - anchor + half_size) & (HB_WAKE_SIZE - 1));
    int2 held = earlier + ((here - earlier + half_size) & (HB_WAKE_SIZE - 1));
    float2 xz = (float2(spot - half_size) + 0.5) * texel;
    float4 state = _HB_WakeState.Load(int3(here, 0));

    if (_HB_WakeFrame.w > 0.5 || any(spot != held))
        state = float4(0.0, 0.0, 0.0, 0.0);

    float left = HB_WakeHeight(here + int2(-1, 0));
    float right = HB_WakeHeight(here + int2(1, 0));
    float back = HB_WakeHeight(here + int2(0, -1));
    float ahead = HB_WakeHeight(here + int2(0, 1));

    float around = left + right + back + ahead;
    float pull = HB_WAKE_SPEED * HB_WAKE_SPEED / (texel * texel);
    float velocity = (state.g + (around - 4.0 * state.r) * pull * step) * exp(-step * HB_WAKE_DAMP);
    float foam = max(state.b - step * state.a, 0.0);
    float rate = state.a;
    int count = min((int)_HB_WakeFrom.z, HB_WAKE_LIMIT);
    float sunk = 0.0;

    for (int index = 0; index < count; index++)
    {
        float4 head = _HB_WakeStamps[index * HB_WAKE_STAMP];
        float4 tail = _HB_WakeStamps[index * HB_WAKE_STAMP + 1];
        float fall = saturate(1.0 - HB_WakeApart(xz, tail.xy, head.xy) / max(head.z, texel));

        if (fall <= 0.0)
            continue;

        float press = head.w * fall;

        sunk += press * tail.w;

        if (press > foam)
        {
            foam = press;
            rate = tail.z;
        }
    }

    velocity = clamp(velocity, -HB_WAKE_FASTEST, HB_WAKE_FASTEST);

    float height = (state.r + velocity * step) * exp(-step * HB_WAKE_SETTLE);

    height = lerp(height, around * 0.25, saturate(step * HB_WAKE_SMOOTH));
    height -= sunk * step * HB_WAKE_PUSH;

    float2 slope = float2(right - left, ahead - back) * (0.5 / texel) * HB_WAKE_TILT;

    _HB_WakeStateOut[id.xy] = float4(clamp(height, -1.0, 1.0), velocity, foam, rate);
    _HB_WakeLookOut[id.xy] = float4(clamp(-slope, -1.0, 1.0), foam, 0.0);
}
