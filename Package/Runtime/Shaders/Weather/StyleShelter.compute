#pragma kernel Preview
#pragma kernel Heights
#pragma kernel Unpack
#pragma kernel DilateX
#pragma kernel DilateZ
#pragma kernel Finish
#pragma kernel FinishFar

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#define HB_MASK_LIMIT 16

Texture2D<float> _HB_ShelterTop;
Texture2D<float> _HB_ShelterBelow;
Texture2D<float> _HB_ShelterLiquid;
Texture2D<float4> _HB_ShelterRaw;
RWTexture2D<float4> _HB_ShelterRawTarget;
Texture2D<float2> _HB_ShelterCarry;
RWTexture2D<float2> _HB_ShelterCarryTarget;
Texture2D<float2> _HB_ShelterCoverFrom;
RWTexture2D<float2> _HB_ShelterCoverState;
RWTexture2DArray<float4> _HB_ShelterMapTarget;
RWTexture2D<float> _HB_ShelterDropsTarget;
Texture2DArray<float4> _HB_ShelterMap;
RWTexture2D<float4> _HB_ShelterPreview;
RWTexture2D<float2> _HB_ShelterHeights;

float4x4 _HB_ShelterViewProj;
float4 _HB_ShelterHeight;
float4 _HB_ShelterCell;
float4 _HB_ShelterPreviewArea;
float4 _HB_ShelterDilate;
float4 _HB_ShelterMasks[HB_MASK_LIMIT];
float4 _HB_ShelterMaskCount;
float4 _HB_ShelterCoverStep;

#define HB_HEIGHT_SCALE   _HB_ShelterHeight.x
#define HB_HEIGHT_BIAS    _HB_ShelterHeight.y
#define HB_RESOLUTION     _HB_ShelterHeight.z
#define HB_SLICE          _HB_ShelterHeight.w

#define HB_CELL_CENTRE    _HB_ShelterCell.xy
#define HB_CELL_EXTENT    _HB_ShelterCell.z
#define HB_CELL_LIQUID    (fmod(_HB_ShelterCell.w, 2.0) > 0.5)
#define HB_CELL_UNDER     (_HB_ShelterCell.w > 1.5)

#define HB_PREVIEW_SLICE   _HB_ShelterPreviewArea.x
#define HB_PREVIEW_CHANNEL _HB_ShelterPreviewArea.y
#define HB_PREVIEW_EYE     _HB_ShelterPreviewArea.z
#define HB_REACH          ((int)_HB_ShelterDilate.x)
#define HB_MASK_COUNT     ((int)_HB_ShelterMaskCount.x)
#define HB_MASK_BLOCKING  ((int)_HB_ShelterMaskCount.y)
#define HB_COVER_SHIFT    ((int2)_HB_ShelterCoverStep.xy)
#define HB_COVER_STEP     _HB_ShelterCoverStep.z

#define HB_PREVIEW_RANGE  10.0
#define HB_EMPTY_MARGIN   0.05
#define HB_MAX_REACH      12
#define HB_UNDER_EMPTY    0.05
#define HB_OVERHANG_CLEAR 0.5
#define HB_NONE           -1e6
#define HB_NONE_ABOVE     -1e5
#define HB_COVER_CLEAR    0.5

float2 HB_CellWorld(int2 texel, int size)
{
    return HB_CELL_CENTRE + ((float2)texel + 0.5 - size * 0.5) * (HB_CELL_EXTENT / size);
}

int2 HB_DrawnTexel(float2 world, int size)
{
    float2 uv = mul(_HB_ShelterViewProj, float4(world.x, 0.0, world.y, 1.0)).xy;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = -uv.y;
#endif
    uv = uv * 0.5 + 0.5;

    return clamp((int2)floor(uv * size), 0, size - 1);
}

[numthreads(8, 8, 1)]
void Unpack(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;
    int2 texel = (int2)id.xy;

    if (any(texel >= size))
        return;

    int3 drawn = int3(HB_DrawnTexel(HB_CellWorld(texel, size), size), 0);

    float top = _HB_ShelterTop.Load(drawn) * HB_HEIGHT_SCALE + HB_HEIGHT_BIAS;
    float lowest = HB_HEIGHT_BIAS + min(HB_HEIGHT_SCALE, 0.0);
    float under = _HB_ShelterBelow.Load(drawn) * HB_HEIGHT_SCALE + HB_HEIGHT_BIAS;
    float nearest = max(HB_HEIGHT_BIAS, HB_HEIGHT_SCALE + HB_HEIGHT_BIAS);
    float liquid = HB_CELL_LIQUID ? _HB_ShelterLiquid.Load(drawn) : HB_NONE;

    _HB_ShelterRawTarget[texel] = float4(top > lowest + HB_EMPTY_MARGIN ? top : HB_NONE,
                                         HB_CELL_UNDER && under < nearest - HB_UNDER_EMPTY ? under : HB_NONE,
                                         liquid, 0.0);
}

[numthreads(8, 8, 1)]
void DilateX(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;
    int2 texel = (int2)id.xy;

    if (any(texel >= size))
        return;

    float2 overhang = float2(HB_NONE, HB_NONE);

    for (int i = -HB_MAX_REACH; i <= HB_MAX_REACH; i++)
    {
        if (abs(i) > HB_REACH)
            continue;

        float2 other = _HB_ShelterRaw.Load(int3(clamp(texel + int2(i, 0), 0, size - 1), 0)).rg;

        if (other.y > overhang.y)
            overhang = other;
    }

    _HB_ShelterCarryTarget[texel] = overhang;
}

[numthreads(8, 8, 1)]
void DilateZ(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;
    int2 texel = (int2)id.xy;

    if (any(texel >= size))
        return;

    float4 raw = _HB_ShelterRaw.Load(int3(texel, 0));
    float highest = raw.r;

    for (int i = -HB_MAX_REACH; i <= HB_MAX_REACH; i++)
    {
        if (abs(i) > HB_REACH)
            continue;

        float2 overhang = _HB_ShelterCarry.Load(int3(clamp(texel + int2(0, i), 0, size - 1), 0));

        if (overhang.y > raw.r + HB_OVERHANG_CLEAR)
            highest = max(highest, overhang.x);
    }

    _HB_ShelterRawTarget[texel] = float4(highest, raw.gba);
}

float2 HB_Domes(float2 world, float top)
{
    float2 heights = float2(top, top);

    for (int i = 0; i < HB_MASK_LIMIT; i++)
    {
        if (i >= HB_MASK_COUNT)
            break;

        float4 mask = _HB_ShelterMasks[i];
        float2 offset = world - mask.xz;
        float reach = mask.w * mask.w - dot(offset, offset);

        if (reach <= 0.0)
            continue;

        float dome = mask.y + sqrt(reach);

        heights.x = max(heights.x, dome);

        if (i < HB_MASK_BLOCKING)
            heights.y = max(heights.y, dome);
    }

    return heights;
}

[numthreads(8, 8, 1)]
void Finish(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;
    int2 texel = (int2)id.xy;

    if (any(texel >= size))
        return;

    float4 raw = _HB_ShelterRaw.Load(int3(texel, 0));
    float2 domes = HB_Domes(HB_CellWorld(texel, size), raw.r);

    int2 from = texel + HB_COVER_SHIFT;
    float2 state = float2(1.0, raw.r);

    if (all(from >= 0) && all(from < size))
        state = _HB_ShelterCoverFrom.Load(int3(from, 0));

    float age = state.x;

    if (raw.r > state.y + HB_COVER_CLEAR)
        age = 1.0;
    else if (raw.r < state.y - HB_COVER_CLEAR)
        age = 0.0;

    age = saturate(age + HB_COVER_STEP);

    _HB_ShelterCoverState[texel] = float2(age, raw.r);
    _HB_ShelterMapTarget[uint3(id.xy, 0)] = float4(domes.x, raw.g, raw.b, age);
    _HB_ShelterDropsTarget[texel] = max(domes.y, raw.b);
}

[numthreads(8, 8, 1)]
void FinishFar(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;
    int2 texel = (int2)id.xy;

    if (any(texel >= size))
        return;

    float4 raw = _HB_ShelterRaw.Load(int3(texel, 0));
    float2 domes = HB_Domes(HB_CellWorld(texel, size), raw.r);

    _HB_ShelterMapTarget[uint3(id.xy, (uint)HB_SLICE)] = float4(domes.x, raw.g, raw.b, 1.0);
}

[numthreads(8, 8, 1)]
void Heights(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    _HB_ShelterHeights[id.xy] = _HB_ShelterMap.Load(int4(id.xy, 0, 0)).rg;
}

[numthreads(8, 8, 1)]
void Preview(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    float4 packed = _HB_ShelterMap.Load(int4(id.xy, (int)HB_PREVIEW_SLICE, 0));
    int channel = (int)HB_PREVIEW_CHANNEL;
    float4 colour = float4(0.05, 0.1, 0.35, 1.0);

    if (channel == 3)
    {
        colour = float4(1.0, packed.a, packed.a, 1.0);
    }
    else
    {
        float height = channel == 0 ? packed.r : channel == 1 ? packed.g : packed.b;

        if (height > HB_NONE_ABOVE)
        {
            float level = saturate((height - HB_PREVIEW_EYE) / (2.0 * HB_PREVIEW_RANGE) + 0.5);

            colour = float4(level, level, level, 1.0);
        }
    }

    float2 fromCentre = abs((float2)id.xy + 0.5 - size * 0.5);

    if (max(fromCentre.x, fromCentre.y) < 2.0)
        colour = float4(1.0, 0.2, 0.1, 1.0);

    _HB_ShelterPreview[id.xy] = colour;
}
