#pragma kernel Follow
#pragma kernel Open
#pragma kernel Far
#pragma kernel Ground
#pragma kernel FarCover
#pragma kernel Reach
#pragma kernel Erode
#pragma kernel Dilate
#pragma kernel ShoreSeed
#pragma kernel ShoreJump
#pragma kernel ShoreField
#pragma kernel GroundClear
#pragma kernel Slope

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

Texture2D<float> _HB_SkyDepth;
Texture2D<float> _HB_SkyLiquid;
RWTexture2D<float> _HB_Shelter;
RWTexture2D<half> _HB_ShelterFade;
Texture2D<float> _HB_ShelterSource;
RWTexture2D<float> _HB_ShelterRain;
RWTexture2D<float> _HB_ShelterFloor;
RWTexture2D<float> _HB_ShelterSeabed;
Texture2D<float> _HB_GroundHeightmap;
Texture2D<float> _HB_ShelterGround;
SamplerState sampler_LinearClamp;
Texture2D<float2> _HB_ShoreSeedIn;
RWTexture2D<float2> _HB_ShoreSeedOut;
RWTexture2D<float4> _HB_ShoreOut;
Texture2D<float2> _HB_ShoreLevelMap;

float4x4 _HB_SkyViewProj;
float4 _HB_ShelterHeight;
float4 _HB_ShelterWindow;
float4 _HB_ShelterFollow;
float _HB_ShelterBase;
float _HB_ShelterMaskCount;
float4 _HB_ShoreParams;
float4 _HB_ShoreArea;
float4 _HB_ShoreOrigin;
float4 _HB_GroundOrigin;
float4 _HB_GroundSize;
float4 _HB_ShelterGroundParams;
float4 _HB_ShelterMasks[16];

#define HB_OPEN_TILE     8
#define HB_OPEN_RADIUS   2
#define HB_OPEN_ERODED   (HB_OPEN_TILE + HB_OPEN_RADIUS * 2)
#define HB_OPEN_LOADED   (HB_OPEN_TILE + HB_OPEN_RADIUS * 4)
#define HB_OPEN_DISK     5
#define HB_LIQUID_LIFT   0.7
#define HB_LIQUID_FAR    2.0
#define HB_LIQUID_TOP    0.02
#define HB_GROUND_UNPACK (65535.0 / 32766.0)
#define HB_OPEN_SKY      -30000.0
#define HB_EMPTY_MARGIN  0.05
#define HB_REACH_FIRST   2.0
#define HB_REACH_GROW    1.54
#define HB_REACH_STEPS   9
#define HB_REACH_REFINE  5
#define HB_REACH_METRES  20.0
#define HB_REACH_DEEP    1000.0
#define HB_REACH_BASE    15.0
#define HB_REACH_PER_METRE 4.0
#define HB_SEABED_RADIUS 3
#define HB_SLOPE_RISE    0.25
#define HB_SHORE_LEVEL   _HB_ShoreParams.x
#define HB_SHORE_DRY     10000.0
#define HB_SHORE_STEP    _HB_ShoreParams.y
#define HB_SHORE_FAR     _HB_ShoreParams.z

groupshared float s_Loaded[HB_OPEN_LOADED * HB_OPEN_LOADED];
groupshared float s_Eroded[HB_OPEN_ERODED * HB_OPEN_ERODED];

#define HB_HEIGHT_SCALE  _HB_ShelterHeight.x
#define HB_HEIGHT_BIAS   _HB_ShelterHeight.y
#define HB_RESOLUTION    _HB_ShelterHeight.z
#define HB_TEXEL_SIZE    _HB_ShelterHeight.w

#define HB_STEP_UP       _HB_ShelterFollow.x
#define HB_STEP_DOWN     _HB_ShelterFollow.y
#define HB_KNOWN         _HB_ShelterFollow.z
#define HB_VISIBLE       _HB_ShelterFollow.w

float HB_SkyHeight(float depth)
{
    float height = depth * HB_HEIGHT_SCALE + HB_HEIGHT_BIAS;
    float lowest = HB_HEIGHT_BIAS + min(HB_HEIGHT_SCALE, 0.0);

    return height > lowest + HB_EMPTY_MARGIN ? height : HB_OPEN_SKY;
}

float2 HB_DepthUV(float2 worldXZ)
{
    float4 clip = mul(_HB_SkyViewProj, float4(worldXZ.x, 0.0, worldXZ.y, 1.0));
    float2 uv = clip.xy;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = -uv.y;
#endif
    return uv * 0.5 + 0.5;
}

float HB_ShelterMasked(float2 world, float height)
{
    for (int index = 0; index < (int)_HB_ShelterMaskCount; index++)
    {
        float4 mask = _HB_ShelterMasks[index];
        float2 away = world - mask.xz;
        float inside = mask.w * mask.w - dot(away, away);

        if (inside > 0.0)
            height = max(height, mask.y + sqrt(inside));
    }

    return height;
}

[numthreads(8, 8, 1)]
void Follow(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    int2 low = (int2)_HB_ShelterWindow.xy;
    int2 world = low + (int2)((uint2)((int2)id.xy - low) & (uint)(size - 1));

    float2 centre = (world + 0.5) * HB_TEXEL_SIZE;
    float2 origin = HB_DepthUV(centre);
    float2 stepX = HB_DepthUV(centre + float2(HB_TEXEL_SIZE, 0.0)) - origin;
    float2 stepZ = HB_DepthUV(centre + float2(0.0, HB_TEXEL_SIZE)) - origin;

    float2 groundUV = (centre - _HB_ShelterGroundParams.xy) * _HB_ShelterGroundParams.z + 0.5;
    float ground = _HB_ShelterGroundParams.w > 0.5 && all(abs(groundUV - 0.5) < 0.5)
        ? _HB_ShelterGround.SampleLevel(sampler_LinearClamp, groundUV, 0)
        : HB_OPEN_SKY;

    float heights[25];

    UNITY_UNROLL
    for (int z = 0; z < 5; z++)
    {
        UNITY_UNROLL
        for (int x = 0; x < 5; x++)
        {
            float2 uv = origin + (x - 2) * stepX + (z - 2) * stepZ;
            int2 texel = clamp((int2)floor(uv * size), 0, size - 1);

            float solid = HB_SkyHeight(_HB_SkyDepth.Load(int3(texel, 0)));
            float liquid = HB_SkyHeight(_HB_SkyLiquid.Load(int3(texel, 0)));

            heights[z * 5 + x] = liquid > max(solid, ground) - HB_LIQUID_TOP ? liquid + HB_LIQUID_LIFT : solid;
        }
    }

    float closed = 1e9;

    UNITY_UNROLL
    for (int cz = 1; cz < 4; cz++)
    {
        UNITY_UNROLL
        for (int cx = 1; cx < 4; cx++)
        {
            float dilated = -1e9;

            UNITY_UNROLL
            for (int dz = -1; dz <= 1; dz++)
            {
                UNITY_UNROLL
                for (int dx = -1; dx <= 1; dx++)
                    dilated = max(dilated, heights[(cz + dz) * 5 + cx + dx]);
            }

            closed = min(closed, dilated);
        }
    }

    int2 previousLow = (int2)_HB_ShelterWindow.zw;
    bool known = HB_KNOWN > 0.5 && all(world >= previousLow) && all(world < previousLow + size);

    closed = HB_ShelterMasked(centre, closed);

    float floorHeight = max(closed, ground);
    float previous = _HB_Shelter[id.xy];
    float result = closed;
    half fade = 1.0h;

    if (known)
    {
        float from = max(previous, ground);

        fade = _HB_ShelterFade[id.xy];

        if (from > floorHeight + HB_VISIBLE)
        {
            result = floorHeight;
            fade = 0.0h;
        }
        else
        {
            result = floorHeight > from
                ? min(from + HB_STEP_UP, floorHeight)
                : max(min(from, floorHeight + HB_VISIBLE) - HB_STEP_DOWN, floorHeight);
        }

        if (closed < ground && result <= ground)
            result = closed;

        fade = min(fade + half(HB_STEP_DOWN / HB_VISIBLE), 1.0h);
    }

    _HB_Shelter[id.xy] = result;
    _HB_ShelterFade[id.xy] = fade;
}

[numthreads(8, 8, 1)]
void Far(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    float2 world = _HB_ShelterWindow.xy + ((float2)id.xy + 0.5 - size * 0.5) * HB_TEXEL_SIZE;
    int2 texel = clamp((int2)floor(HB_DepthUV(world) * size), 0, size - 1);

    float solid = HB_SkyHeight(_HB_SkyDepth.Load(int3(texel, 0)));

    _HB_Shelter[id.xy] = solid;
    _HB_ShelterSeabed[id.xy] = solid;
}

[numthreads(8, 8, 1)]
void GroundClear(uint3 id : SV_DispatchThreadID)
{
    if (any((int2)id.xy >= (int)HB_RESOLUTION))
        return;

    _HB_ShelterSeabed[id.xy] = HB_OPEN_SKY;
}

[numthreads(8, 8, 1)]
void Ground(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    float2 world = _HB_ShelterWindow.xy + ((float2)id.xy + 0.5 - size * 0.5) * HB_TEXEL_SIZE;
    float2 uv = (world - _HB_GroundOrigin.xz) / _HB_GroundSize.xz;

    if (any(uv < 0.0) || any(uv > 1.0))
        return;

    float2 texel = (uv * (_HB_GroundSize.w - 1.0) + 0.5) / _HB_GroundSize.w;
    float height = _HB_GroundOrigin.y
                 + _HB_GroundHeightmap.SampleLevel(sampler_LinearClamp, texel, 0)
                 * (_HB_GroundSize.y * HB_GROUND_UNPACK);

    _HB_ShelterSeabed[id.xy] = max(_HB_ShelterSeabed[id.xy], height);
}

[numthreads(8, 8, 1)]
void FarCover(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    float2 world = _HB_ShelterWindow.xy + ((float2)id.xy + 0.5 - size * 0.5) * HB_TEXEL_SIZE;
    int2 texel = clamp((int2)floor(HB_DepthUV(world) * size), 0, size - 1);

    float solid = _HB_Shelter[id.xy];
    float liquid = HB_SkyHeight(_HB_SkyLiquid.Load(int3(texel, 0)));
    float covered = liquid > _HB_ShelterSource[id.xy] - HB_LIQUID_TOP
        ? liquid + HB_LIQUID_LIFT + HB_TEXEL_SIZE * HB_LIQUID_FAR
        : solid;

    _HB_Shelter[id.xy] = HB_ShelterMasked(world, covered);
}

[numthreads(HB_OPEN_TILE, HB_OPEN_TILE, 1)]
void Open(uint3 group : SV_GroupID, uint3 local : SV_GroupThreadID, uint index : SV_GroupIndex)
{
    int size = (int)HB_RESOLUTION;
    int2 corner = (int2)group.xy * HB_OPEN_TILE - HB_OPEN_RADIUS * 2;

    for (uint i = index; i < HB_OPEN_LOADED * HB_OPEN_LOADED; i += HB_OPEN_TILE * HB_OPEN_TILE)
    {
        int2 texel = corner + int2(i % HB_OPEN_LOADED, i / HB_OPEN_LOADED);
        s_Loaded[i] = _HB_ShelterSource[(uint2)(texel & (size - 1))];
    }

    GroupMemoryBarrierWithGroupSync();

    for (uint j = index; j < HB_OPEN_ERODED * HB_OPEN_ERODED; j += HB_OPEN_TILE * HB_OPEN_TILE)
    {
        int2 centre = int2(j % HB_OPEN_ERODED, j / HB_OPEN_ERODED) + HB_OPEN_RADIUS;
        float eroded = 1e9;

        for (int ez = -HB_OPEN_RADIUS; ez <= HB_OPEN_RADIUS; ez++)
        {
            for (int ex = -HB_OPEN_RADIUS; ex <= HB_OPEN_RADIUS; ex++)
            {
                if (ex * ex + ez * ez <= HB_OPEN_DISK)
                    eroded = min(eroded, s_Loaded[(centre.y + ez) * HB_OPEN_LOADED + centre.x + ex]);
            }
        }

        s_Eroded[j] = eroded;
    }

    GroupMemoryBarrierWithGroupSync();

    int2 own = (int2)local.xy + HB_OPEN_RADIUS;
    float opened = -1e9;

    UNITY_UNROLL
    for (int dz = -HB_OPEN_RADIUS; dz <= HB_OPEN_RADIUS; dz++)
    {
        UNITY_UNROLL
        for (int dx = -HB_OPEN_RADIUS; dx <= HB_OPEN_RADIUS; dx++)
        {
            if (dx * dx + dz * dz <= HB_OPEN_DISK)
                opened = max(opened, s_Eroded[(own.y + dz) * HB_OPEN_ERODED + own.x + dx]);
        }
    }

    uint2 id = group.xy * HB_OPEN_TILE + local.xy;

    if (all((int2)id < size))
        _HB_ShelterRain[id] = max(opened - _HB_ShelterBase, HB_OPEN_SKY);
}

static const float2 s_ReachRing[8] =
{
    float2(1.0, 0.0), float2(0.7071, 0.7071), float2(0.0, 1.0), float2(-0.7071, 0.7071),
    float2(-1.0, 0.0), float2(-0.7071, -0.7071), float2(0.0, -1.0), float2(0.7071, -0.7071)
};

float HB_ReachHeight(int2 world, int2 low, int size, float2 direction, float span, float top)
{
    int2 texel = world + (int2)round(direction * span);

    if (any(texel < low) || any(texel >= low + size))
        return top;

    return _HB_ShelterSource[(uint2)(texel & (size - 1))];
}

[numthreads(8, 8, 1)]
void Reach(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    int2 low = (int2)_HB_ShelterWindow.xy;
    int2 world = low + (int2)((uint2)((int2)id.xy - low) & (uint)(size - 1));

    float top = _HB_ShelterSource[id.xy];
    float edge = top - HB_REACH_BASE;
    float limit = HB_REACH_METRES / HB_TEXEL_SIZE;
    float nearest = limit;

    UNITY_UNROLL
    for (int ray = 0; ray < 8; ray++)
    {
        float2 direction = s_ReachRing[ray];
        float inside = 0.0;
        float outside = limit;
        float below = top;
        float span = HB_REACH_FIRST;
        bool open = false;

        UNITY_UNROLL
        for (int march = 0; march < HB_REACH_STEPS; march++)
        {
            if (!open)
            {
                float height = HB_ReachHeight(world, low, size, direction, span, top);

                if (height > edge)
                    inside = span;
                else
                {
                    outside = span;
                    below = height;
                    open = true;
                }
            }

            span *= HB_REACH_GROW;
        }

        if (open)
        {
            UNITY_UNROLL
            for (int refine = 0; refine < HB_REACH_REFINE; refine++)
            {
                float middle = (inside + outside) * 0.5;
                float height = HB_ReachHeight(world, low, size, direction, middle, top);

                if (height > edge)
                    inside = middle;
                else
                {
                    outside = middle;
                    below = height;
                }
            }

            if (outside < limit && below < edge - HB_REACH_PER_METRE * outside * HB_TEXEL_SIZE)
                nearest = min(nearest, outside);
        }
    }

    _HB_ShelterFloor[id.xy] = nearest >= limit
        ? top - HB_REACH_DEEP
        : edge - HB_REACH_PER_METRE * nearest * HB_TEXEL_SIZE;
}

float HB_SeabedSpan(uint2 id, bool lowest)
{
    int size = (int)HB_RESOLUTION;
    float span = lowest ? 1e9 : -1e9;

    for (int z = -HB_SEABED_RADIUS; z <= HB_SEABED_RADIUS; z++)
    {
        for (int x = -HB_SEABED_RADIUS; x <= HB_SEABED_RADIUS; x++)
        {
            if (x * x + z * z > HB_SEABED_RADIUS * HB_SEABED_RADIUS + 1)
                continue;

            float height = _HB_ShelterSource[(uint2)clamp((int2)id + int2(x, z), 0, size - 1)];

            span = lowest ? min(span, height) : max(span, height);
        }
    }

    return span;
}

[numthreads(8, 8, 1)]
void Erode(uint3 id : SV_DispatchThreadID)
{
    if (all((int2)id.xy < (int)HB_RESOLUTION))
        _HB_ShelterFloor[id.xy] = HB_SeabedSpan(id.xy, true);
}

[numthreads(8, 8, 1)]
void Dilate(uint3 id : SV_DispatchThreadID)
{
    if (all((int2)id.xy < (int)HB_RESOLUTION))
        _HB_ShelterFloor[id.xy] = HB_SeabedSpan(id.xy, false);
}

float HB_ShoreRise(int2 texel)
{
    float2 world = _HB_ShoreOrigin.xy + ((float2)texel + 0.5 - HB_RESOLUTION * 0.5) * HB_TEXEL_SIZE;
    float2 uv = (world - _HB_ShoreArea.xy) * _HB_ShoreArea.zw + 0.5;

    float2 stored = _HB_ShoreLevelMap.SampleLevel(sampler_LinearClamp, uv, 0);

    return stored.y > 0.5 ? -HB_SHORE_DRY : stored.x;
}

bool HB_ShoreSeeded(float2 seed)
{
    return seed.x > -1e5;
}

[numthreads(8, 8, 1)]
void ShoreSeed(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    static const int2 around[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };

    float here = _HB_ShelterSource[id.xy] - HB_SHORE_LEVEL - HB_ShoreRise((int2)id.xy);
    float2 sum = float2(0.0, 0.0);
    float count = 0.0;

    for (int side = 0; side < 4; side++)
    {
        int2 texel = (int2)id.xy + around[side];

        if (any(texel < 0) || any(texel >= size))
            continue;

        float there = _HB_ShelterSource[(uint2)texel] - HB_SHORE_LEVEL - HB_ShoreRise(texel);

        if ((here > 0.0) != (there > 0.0))
        {
            sum += (float2)id.xy + (float2)around[side] * (here / (here - there));
            count += 1.0;
        }
    }

    _HB_ShoreSeedOut[id.xy] = count > 0.0 ? sum / count : float2(-1e6, -1e6);
}

[numthreads(8, 8, 1)]
void ShoreJump(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    int reach = (int)HB_SHORE_STEP;
    float2 here = (float2)id.xy;
    float2 best = _HB_ShoreSeedIn[id.xy];
    float nearest = HB_ShoreSeeded(best) ? dot(best - here, best - here) : 1e12;

    for (int z = -1; z <= 1; z++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 texel = (int2)id.xy + int2(x, z) * reach;

            if (any(texel < 0) || any(texel >= size))
                continue;

            float2 seed = _HB_ShoreSeedIn[(uint2)texel];
            float away = dot(seed - here, seed - here);

            if (HB_ShoreSeeded(seed) && away < nearest)
            {
                nearest = away;
                best = seed;
            }
        }
    }

    _HB_ShoreSeedOut[id.xy] = best;
}

[numthreads(8, 8, 1)]
void ShoreField(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    float2 seed = _HB_ShoreSeedIn[id.xy];
    float2 toward = seed - (float2)id.xy;
    float span = length(toward);

    bool seeded = HB_ShoreSeeded(seed);
    bool wet = _HB_ShelterSource[id.xy] < HB_SHORE_LEVEL + HB_ShoreRise((int2)id.xy);

    float away = seeded ? min(span * HB_TEXEL_SIZE, HB_SHORE_FAR) : HB_SHORE_FAR;
    float2 direction = seeded && span > 1e-3 ? toward / span : float2(0.0, 0.0);

    _HB_ShoreOut[id.xy] = float4(wet ? away : -away, direction, 0.0);
}

[numthreads(8, 8, 1)]
void Slope(uint3 id : SV_DispatchThreadID)
{
    int size = (int)HB_RESOLUTION;

    if (any((int2)id.xy >= size))
        return;

    int reach = (int)_HB_ShelterWindow.x;
    float height = _HB_ShelterSource[id.xy];

    for (int z = -1; z <= 1; z++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 other = clamp((int2)id.xy + int2(x, z) * reach, 0, size - 1);
            float away = length((float2)(other - (int2)id.xy)) * HB_TEXEL_SIZE;

            float cap = _HB_ShelterWindow.y + HB_ShoreRise(other);

            height = max(height, min(_HB_ShelterSource[(uint2)other], cap) - away * HB_SLOPE_RISE);
        }
    }

    _HB_ShelterFloor[id.xy] = height;
}
